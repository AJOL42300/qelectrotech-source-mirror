	<uuid uuid="{9a9176a2-557f-5ff6-95b0-bc15021d7ee6}"/>
	<names>
		<name lang="en">AF1115 servo drive, 1 axis - realistic</name>
		<name lang="fr">AF1115 variateur, 1 axe(s) - réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">AF1115</elementInformation>
		<elementInformation name="designation" show="1">AF1115 servo drive, 1 axis</elementInformation>
		<elementInformation name="description" show="1">AF 1-axis drive (the second digit of the reference is the number of axes). Rating from the project nomenclature: 1.5 kW, 3.4 A. Redrawn in vector from a picture of the project, terminals snapped to the 10 px grid. Mains terminals drawn as 3-phase L1 L2 L3 PE RB+ RB-; the 1-phase version (L N PE RB+ RB-) is not drawn. 24V_A..C are the '25 Vdc' of a blurry picture, read as 24 V. Check against the datasheet.</elementInformation>
	</elementInformations>
