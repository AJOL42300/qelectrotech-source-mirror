                                    <definition height="80" hotspot_x="20" hotspot_y="10" link_type="simple" type="element" version="0.100.0" width="100">
	<uuid uuid="{8fddf79d-05e7-5c2f-9777-44204fc70d9e}"/>
	<names>
		<name lang="en">iC60N circuit breaker 3P 10 A C</name>
		<name lang="fr">Disjoncteur iC60N 3P 10 A C</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">A9F74310</elementInformation>
		<elementInformation name="designation" show="1">iC60N miniature circuit breaker, 3P, 10 A, C curve</elementInformation>
		<elementInformation name="description" show="1">Miniature circuit breaker iC60N, 3 poles, 10 A, C curve, thermal-magnetic, 10 kA (IEC/EN 60947-2). Width 6 x 9 mm (54 mm), height 85 mm. One terminal per pole, top and bottom (1-2, 3-4...).</elementInformation>
		<elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">Acti9 iOF open/close auxiliary contact (also fault indication), 1 changeover (1 NO + 1 NC), 6 A at 240 V AC, 9 mm wide, for iC60, iID, iDPN Vigi and iSW 40-125 (public compatibility list). Terminals C, NC, NO ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">iOF auxiliary contact, Acti9, 1 changeover, AC/DC</elementInformation>
		<elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary1" show="0">A9A26924</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">0</elementInformation>
		<elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">Add-on residual current device Vigi iC60, 3P, 25 A, 30 mA, type AC, instantaneous, 400-415 V AC, for iC60. Width 6 x 9 mm (54 mm), height 91 mm, depth 73.5 mm. Discontinued 23 Sept 2025, not replaced. Mounted next to an iC60: its own terminals are drawn.</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">Vigi iC60 add-on residual current device, 3P, 25 A, 30 mA, type AC</elementInformation>
		<elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary2" show="0">A9V11325</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">0</elementInformation>
		<elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">Acti9 iMN instantaneous undervoltage release, control voltage 220-240 V AC 50/60 Hz, trips between 70 % and 35 % of Un, 2 modules of 9 mm, for iC60, iID, iDPN Vigi and iSW-NA (public product page). Coil terminals D1-D2 ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">iMN undervoltage release, Acti9, 220-240 V AC</elementInformation>
		<elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary3" show="0">A9A26960</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">0</elementInformation>
		<elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary4" show="0">Acti9 iMX+OF shunt trip release with an open/close auxiliary contact (OF), control voltage 220-415 V AC, for iC60, iID, iC40 and iSW-NA (public product page). Coil terminals C1-C2 and OF terminals 11, 12, 14 ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary4" show="0">iMX+OF shunt trip release with auxiliary contact, Acti9, 220-415 V AC</elementInformation>
		<elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary4" show="0">A9A26946</elementInformation>
		<elementInformation name="quantity_auxiliary4" show="0">0</elementInformation>
	</elementInformations>
