                                    <definition height="210" hotspot_x="50" hotspot_y="80" link_type="master" type="element" version="0.100.0" width="200">
	<uuid uuid="{57412dea-0926-5431-a689-2fbd93c8e1ec}"/>
	<names>
		<name lang="en">KS105C1-16DT Compact PLC, 8 DI, 8 DO, RS232, RS485, CAN, description view</name>
		<name lang="fr">KS105C1-16DT Automate compact, 8 E TOR, 8 S TOR, RS232, RS485, CAN, vue description</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Kinco</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">KS105C1-16DT</elementInformation>
		<elementInformation name="designation" show="1">Compact PLC, 8 DI, 8 DO, RS232, RS485, CAN</elementInformation>
		<elementInformation name="description" show="1">Kinco KS105 compact PLC, 8 digital inputs and 8 transistor outputs, RS232 and RS485 ports and one CAN port. Terminal names are the markings of the unit; the I/O table lists the channels. Check the pinout against the datasheet of your unit.</elementInformation>
		<elementInformation name="quantity" show="0">1</elementInformation>
		<elementInformation name="unity" show="0">pcs</elementInformation>
		<elementInformation name="width" show="0">25.4</elementInformation>
		<elementInformation name="height" show="0">100</elementInformation>
		<elementInformation name="depth" show="0">84.5</elementInformation>
		<elementInformation name="auxiliary1" show="0">RJ45 plug</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">RJ45 plug for the cable of a PORT0, CAN or expansion socket</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">RJ45 plug</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">2</elementInformation>
		<elementInformation name="unity_auxiliary1" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary2" show="0">Screw terminal blocks</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">Terminal blocks of the unit: inputs, outputs, power supply and RS485</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">Screw terminal blocks</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">1</elementInformation>
		<elementInformation name="unity_auxiliary2" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary3" show="0">DIN rail</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">Symmetrical DIN rail 35 mm</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">DIN rail</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">1</elementInformation>
		<elementInformation name="unity_auxiliary3" show="0">pcs</elementInformation>
