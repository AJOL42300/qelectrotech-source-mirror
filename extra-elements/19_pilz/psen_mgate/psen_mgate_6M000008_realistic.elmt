<definition version="0.100.0" type="element" link_type="master" width="360" height="270" hotspot_x="20" hotspot_y="70">
	<uuid uuid="{06ff8761-0669-52ad-bb3e-307dc8df5ebd}"/>
	<names>
		<name lang="en">Pilz 6M000008 PSENmgate safety gate system entry from right, 2 LED pushbuttons + E-STOP, realistic view</name>
		<name lang="fr">Système de porte de sécurité PSENmgate Pilz 6M000008 entry from right, 2 boutons lumineux + arrêt d'urgence, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Pilz</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">6M000008</elementInformation>
		<elementInformation name="designation" show="1">Système de porte de sécurité PSENmgate, 2 boutons lumineux (1 NO) et 1 arrêt d'urgence (2 NC + 1 NO), codé, rearmement automatique, entrée par la droite, connecteur M23 mâle 19 broches, sortie de câble vers le bas, connexion simple</elementInformation>
		<elementInformation name="description" show="1">PSENmgate safety gate system (PSEN mg1-A-LLFXX, single connection), 2 illuminated pushbuttons (1 NO each) and 1 E-STOP (2 NC + 1 NO), coded, automatic reset, entry from right, 19-pin M23 male connector, cable outlet downwards, 24 V DC, 2 safety outputs (12, 22) and 1 signal output, actuator PSEN ml 1.1 (570480). VERIFIED (Pilz e-shop page of the order number and operating manual 1006672, pin assignment table): pin 1 Y1 red, 2 Y32 grey, 3 ES_SO violet, 4 terminal 22 yellow, 5 terminal 12 green, 6 A2 blue, 7 S41 white, 8 reserved red-blue, 9 ES1.1 grey-brown, 10 B2 brown-green, 11 ES1.2 yellow-brown, 12 B1 green-yellow, 13 LED2 black, 14 ES2.1 white-yellow, 15 LED1 white-green, 16 ES2.2 white-grey, 17 reserved grey-pink, 18 S31 pink, 19 A1 brown. The colours are those of the Pilz accessory cable only. ASSUMED: the three order numbers 6M000007, 6M000008 and 6M000009 share the same wiring (the manual gives one table for the series); the reserved pins 8 and 17 have no terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
