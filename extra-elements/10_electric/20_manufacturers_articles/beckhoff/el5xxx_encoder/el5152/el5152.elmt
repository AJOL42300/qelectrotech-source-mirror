	<names>
		<name lang="en">EL5152 encoder input terminal</name>
		<name lang="fr">EL5152 borne d'entrée codeur</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL5152</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 2-channel incremental encoder input</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, encoder input terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 A1, 2 B1, 3 24V1, 4 24V2, 5 A2, 6 B2, 7 0V1, 8 0V2. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
