                    <element name="m12_cable_3m.elmt">
                        <definition height="60" hotspot_x="10" hotspot_y="30" link_type="simple" type="element" version="0.100.0" width="120">
	<uuid uuid="{a4582fb3-4626-5f27-af70-00d5267b1bf7}"/>
	<names>
		<name lang="en">Murrelektronik 7000-40021-6340300 M12 moulded cable 3 m</name>
		<name lang="fr">Câble moulé M12 Murrelektronik 7000-40021-6340300 3 m</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">7000-40021-6340300</elementInformation>
		<elementInformation name="designation" show="1">Câble moulé M12 mâle 0° / M12 femelle 0° codé A, PUR 4x0,34, 3 m</elementInformation>
		<elementInformation name="description" show="1">M12 male 0 deg / M12 female 0 deg, A-coded, PUR 4 x 0.34 mm2, 3 m. The female connector has 5 contacts (the contact 5 is present but not wired) and the cable has 4 conductors: 1 brown, 2 white, 3 blue, 4 black on the pins 1 to 4 of both ends (the free contact 5 is the information of the user, not read in the datasheet). Function routing: X1 and X2 are the same channels (1 = pin 4, 2 = pin 2).</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="function_routes">X1:1>X2:1;X1:2>X2:2</kindInformation>
	</kindInformations>
	<informations>Author: QElectroTech contributors
