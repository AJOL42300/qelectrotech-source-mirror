	<names>
		<name lang="en">Murrelektronik MICO Pro 4 channels MICO electronic circuit breaker 4 x 1-10 A</name>
		<name lang="fr">Disjoncteur électronique MICO Murrelektronik MICO Pro 4 channels 4 x 1-10 A</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">9000-41094-0101000</elementInformation>
		<elementInformation name="designation" show="1">4-channel electronic circuit breaker, 24 V DC, 4 x 1-10 A</elementInformation>
		<elementInformation name="description" show="1">one push button with integrated status LED and one current selector per channel; group alarm contact on terminals 13-14 (potential-free); 90% load contact on terminals 23-24 (assumed); modular system (power module + channel modules) drawn as one assembly; module layout and LEDs assumed</elementInformation>
	</elementInformations>
