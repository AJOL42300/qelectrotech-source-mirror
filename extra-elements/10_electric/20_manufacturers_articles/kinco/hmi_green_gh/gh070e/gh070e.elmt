	<names>
		<name lang="en">GH070E HMI Green Enhanced, 7 in, 800 x 480, Ethernet</name>
		<name lang="fr">GH070E IHM Green Enhanced, 7 pouces, 800 x 480, Ethernet</name>
	</names>
	<elementInformations>
