	<uuid uuid="{3d802689-610f-5035-80b5-d3886db6531c}" />
	<names>
		<name lang="en">Mean Well HDR-60-24 DIN-rail power supply 24 V 2.5 A</name>
		<name lang="fr">Alimentation rail DIN Mean Well HDR-60-24 24 V 2.5 A</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">HDR-60-24</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 24 V DC 2.5 A, 60 W, 52.5 mm wide</elementInformation>
		<elementInformation name="description" show="1">Power LED and V ADJ output voltage trimmer on the front; 2 +V and 2 -V output terminals as on the datasheet (parallel screws); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
