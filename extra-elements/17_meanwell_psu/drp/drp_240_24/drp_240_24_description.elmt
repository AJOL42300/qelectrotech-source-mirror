	<names>
		<name lang="en">Mean Well DRP-240-24 DIN-rail power supply 24 V 10 A, description view</name>
		<name lang="fr">Alimentation rail DIN Mean Well DRP-240-24 24 V 10 A, vue descriptive</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">DRP-240-24</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 24 V DC 10 A, 240 W, 125.5 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 2 +V and 2 -V output terminals as on the datasheet (parallel screws); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
