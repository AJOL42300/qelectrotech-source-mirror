	<names>
		<name lang="en">EL3xxx analog input terminal (generic, 16 terminals), description view</name>
		<name lang="fr">EL3xxx borne d'entrée analogique (générique, 16 bornes), vue réaliste</name>
	</names>
	<elementInformations>
