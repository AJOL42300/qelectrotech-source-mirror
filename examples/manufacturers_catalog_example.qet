                        <element name="wdr_60_24_realistic.elmt">
                            <definition height="90" hotspot_x="20" hotspot_y="80" link_type="master" type="element" version="0.100.0" width="60">
	<uuid uuid="{becfb9d4-24bf-5df6-b0e7-7ab8248b218a}"/>
	<names>
		<name lang="en">Mean Well WDR-60-24 DIN-rail power supply 24 V 2.5 A, realistic view</name>
		<name lang="fr">Alimentation rail DIN Mean Well WDR-60-24 24 V 2.5 A, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">WDR-60-24</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 24 V DC 2.5 A, 60 W, 32 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 1 +V and 1 -V output terminals as on the datasheet (parallel screws); DC OK relay contact on terminals 13 and 14 (the datasheet numbers the two relay screws differently; 13/14 is a convention); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
