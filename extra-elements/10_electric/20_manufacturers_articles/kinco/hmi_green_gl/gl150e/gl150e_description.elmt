	<names>
		<name lang="en">GL150E HMI Green Basic, 15 in, 1024 x 768, Ethernet, description view</name>
		<name lang="fr">GL150E IHM Green Basic, 15 pouces, 1024 x 768, Ethernet, vue description</name>
