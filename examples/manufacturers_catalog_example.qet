                            <definition height="90" hotspot_x="30" hotspot_y="80" link_type="master" type="element" version="0.100.0" width="80">
	<uuid uuid="{5241fd7a-cc77-5bb4-b04c-45eb6d1ec340}"/>
	<names>
		<name lang="en">Mean Well NDR-480-24 DIN-rail power supply 24 V 20 A, realistic view</name>
		<name lang="fr">Alimentation rail DIN Mean Well NDR-480-24 24 V 20 A, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">NDR-480-24</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 24 V DC 20 A, 480 W, 85.5 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 2 +V and 2 -V output terminals as on the datasheet (parallel screws); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
