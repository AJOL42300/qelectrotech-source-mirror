				<column index="1" visible="false" />
				<column index="2" visible="false" />
				<column index="3" visible="false" />
				<column index="4" visible="false" />
			</columnVisibility>
			<plcIOs>
				<plcIO type="entree_digitale" address="I1" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>1</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="I3" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>3</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="I2" functionText="" comment="" crossRef="" terminalCount="1">
