	<names>
		<name lang="en">GL043E HMI Green Basic, 4.3 in, 480 x 272, Ethernet, description view</name>
		<name lang="fr">GL043E IHM Green Basic, 4.3 pouces, 480 x 272, Ethernet, vue description</name>
