	<uuid uuid="{706e3226-7669-5737-991c-c6093f11e2d2}"/>
	<names>
		<name lang="en">KS105C2-16DT Compact PLC, 8 DI, 8 DO, RS232, RS485, 2 x CAN - I/O table</name>
