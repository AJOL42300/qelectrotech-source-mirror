                        <element name="lr18xcf12dpoy_e2.elmt">
                            <definition height="160" hotspot_x="50" hotspot_y="40" link_type="simple" type="element" version="0.100.0" width="110">
	<uuid uuid="{84338fca-57d1-5858-8c04-f5ac9558f6eb}"/>
	<names>
		<name lang="en">Lanbao LR18XCF12DPOY-E2 inductive sensor</name>
		<name lang="fr">Capteur inductif Lanbao LR18XCF12DPOY-E2</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Lanbao</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">LR18XCF12DPOY-E2</elementInformation>
		<elementInformation name="designation" show="1">Capteur inductif cylindrique M18 quasi noyé, Sn 12 mm, PNP NO, 10-30 V DC, connecteur M12</elementInformation>
		<elementInformation name="comment" show="1">Detection: inductive (metal targets), quasi flush mounting, nominal sensing distance Sn 12 mm, assured 0-9.6 mm, standard target Fe 36 x 36 x 1 mm</elementInformation>
		<elementInformation name="description" show="1">Inductive sensor, M18x1 housing, quasi flush, nominal range Sn 12 mm (assured 0-9.6 mm), PNP NO, 10-30 V DC, 200 mA, 300 Hz, yellow output LED, protected against short circuit, overload and reverse polarity, IP67, M12 connector. Pins: 1 BN +24 V, 3 BU 0 V, 4 BK output (NO), pin 2 not used on this variant. Wire colours are assumed (standard M12). Mounting: M18x1 thread, 2 nuts AF24 4 mm thick. Overall length 73 mm with the connector (body 56 mm).</elementInformation>
	</elementInformations>
