                                <element name="el2652_realistic.elmt">
                                    <definition height="170" hotspot_x="20" hotspot_y="80" link_type="master" type="element" version="0.100.0" width="40">
	<uuid uuid="{3e19078a-9753-5889-9a9d-04fddc1b958d}"/>
	<names>
		<name lang="en">EL2652 relay output terminal (generic), realistic view</name>
		<name lang="fr">EL2652 borne de sortie relais (générique), vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2652</elementInformation>
		<elementInformation name="designation" show="1">EL2652 EtherCAT Terminal, relay output</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, relay output terminal. Generic layout: contacts 1 to 4; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 4 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false"/>
				<column index="1" visible="false"/>
				<column index="2" visible="false"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
			</columnVisibility>
			<plcIOs>
				<plcIO address="1" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="2" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>2</terminal>
				</plcIO>
				<plcIO address="3" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>3</terminal>
				</plcIO>
				<plcIO address="4" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>4</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
	</kindInformations>
	<informations>Author: QElectroTech contributors
