	<uuid uuid="{84d9f3b0-16a5-5b96-96bb-2a859b06b7e8}" />
	<names>
		<name lang="en">EPP2338 EtherCAT P box, 8 channels</name>
		<name lang="fr">EPP2338 boîtier EtherCAT P, 8 voies</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EPP2338-0002</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT P Box, 8-channel digital input/output, 24 V DC, M12</elementInformation>
		<elementInformation name="description" show="1">EtherCAT P box with a dark housing: four M12 sockets X01 to X04, two channels each (pin 4 = channel A, pin 2 = channel B, pin 1 = +24 V DC Up, pin 3 = GND P, pin 5 not connected), and two M8 EtherCAT P sockets, X50 IN and X51 OUT. Each M12 socket is ONE terminal (X01 to X04) shared by its two channels (X01(1), X01(2)...), the channel is the signal of the I/O table, not the pin. The positions on the housing are assumed. The label of the box is the card id (A1.10).</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
