                        <element name="psm_bc100dpb_e2.elmt">
                            <definition height="160" hotspot_x="60" hotspot_y="40" link_type="simple" type="element" version="0.100.0" width="120">
	<uuid uuid="{4ecfde72-5f41-5330-8dfe-93560583e7d3}"/>
	<names>
		<name lang="en">Lanbao PSM-BC100DPB-E2 diffuse photoelectric sensor</name>
		<name lang="fr">Capteur photoélectrique à réflexion diffuse Lanbao PSM-BC100DPB-E2</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Lanbao</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">PSM-BC100DPB-E2</elementInformation>
		<elementInformation name="designation" show="1">Capteur photoélectrique à réflexion diffuse M18, portée 100 cm, PNP NO/NC, 10-30 V DC, connecteur M12</elementInformation>
		<elementInformation name="comment" show="1">Detection: diffuse reflection (infrared 940 nm), sensing distance 100 cm adjustable with a potentiometer, measured on a 90 % white card of 20 x 20 cm; the real distance depends on the target</elementInformation>
		<elementInformation name="description" show="1">Diffuse photoelectric sensor, metal M18x1 housing, sensing distance 100 cm (infrared 940 nm), PNP output NO/NC selectable with pin 2, 10-30 V DC, 200 mA, single-turn distance adjustment, green LED (power) and yellow LED (output), IP67, M12 4-pin connector. Pins: 1 BN +24 V, 2 WH NO/NC selection (open or +24 V = NO, 0 V = NC), 3 BU 0 V, 4 BK output. Mounting: M18x1 thread, 2 nuts supplied. Overall length 47.2 mm with the connector (the nuts, LED and adjustment positions of the drawing are generic).</elementInformation>
	</elementInformations>
