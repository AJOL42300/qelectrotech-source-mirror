	<uuid uuid="{536b813e-d052-5ea6-a722-d5871ea56854}"/>
	<names>
		<name lang="en">Murrelektronik MICO Basic 4.4.10 MICO electronic circuit breaker 2 x 1-2-3-4 A, 2 x 4-6-8-10 A, realistic view</name>
		<name lang="fr">Disjoncteur électronique MICO Murrelektronik MICO Basic 4.4.10 2 x 1-2-3-4 A, 2 x 4-6-8-10 A, vue réaliste</name>
