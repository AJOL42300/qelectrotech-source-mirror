                        <element name="wdr_60_5_description.elmt">
                            <definition height="110" hotspot_x="60" hotspot_y="90" link_type="master" type="element" version="0.100.0" width="150">
	<uuid uuid="{67033c51-4a19-5608-a654-4c5b14270d7e}"/>
	<names>
		<name lang="en">Mean Well WDR-60-5 DIN-rail power supply 5 V 10 A, description view</name>
		<name lang="fr">Alimentation rail DIN Mean Well WDR-60-5 5 V 10 A, vue descriptive</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">WDR-60-5</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 5 V DC 10 A, 50 W, 32 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 1 +V and 1 -V output terminals as on the datasheet (parallel screws); DC OK relay contact on terminals 13 and 14 (the datasheet numbers the two relay screws differently; 13/14 is a convention); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
