eezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_nsx/nsx100b_3p_tmd100/nsx100b_3p_tmd100_realistic.elmt" uuid="{8b999fb6-97f7-5efc-9fe8-e8685f401da1}" x="140" y="120" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="430" /><terminal id="2" orientation="n" x="120" y="0" /><terminal id="3" orientation="s" x="120" y="430" /><terminal id="4" orientation="n" x="240" y="0" /><terminal id="5" orientation="s" x="240" y="430" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-Q5</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">LV429540</elementInformation><elementInformation name="designation" show="1">ComPacT NSX100B circuit breaker, 3P, 100 A, TMD, 25 kA</elementInformation><elementInformation name="description" show="1">Circuit breaker ComPacT NSX100B, 3P fixed, 25 kA at 415 V, thermal-magnetic trip unit TMD 100 A. 105 x 161 x 86 mm, pole pitch 35 mm.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation><elementInformation name="designation_auxiliary1" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">29450</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation><elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary2" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary2" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">LV429410</elementInformation><elementInformation name="quantity_auxiliary2" show="0">0</elementInformation><elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary3" show="0">Direct rotary handle for ComPacT NSX100/160/250, black handle, padlockable in the OFF position, degree of protection IP40 (IK07). Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary3" show="0">Direct rotary handle, ComPacT NSX100/160/250, black</elementInformation><elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429337</elementInformation><elementInformation name="quantity_auxiliary3" show="0">0</elementInformation><elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation><elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation><elementInformation name="quantity_auxiliary4" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-55" y="493" rotation_point_center="false" uuid="{06adf74c-2658-550f-813d-170f592a6863}"><text>-Q5</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_nsx/nsx250n_3p_frame/nsx250n_3p_frame_realistic.elmt" uuid="{f95d1f24-1dd8-5221-9e97-49eb24c59a9f}" x="560" y="120" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="430" /><terminal id="2" orientation="n" x="120" y="0" /><terminal id="3" orientation="s" x="120" y="430" /><terminal id="4" orientation="n" x="240" y="0" /><terminal id="5" orientation="s" x="240" y="430" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-Q6</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">C25N3</elementInformation><elementInformation name="designation" show="1">ComPacT NSX250N basic frame, 3P, 250 A, 50 kA, without trip unit</elementInformation><elementInformation name="description" show="1">Basic frame ComPacT NSX250N, 3P, 250 A, 50 kA at 415 V, without trip unit. 105 x 161 x 86 mm.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Standard motor mechanism module MT250 for ComPacT NSX250, control voltage 220-240 V AC 50/60 Hz (208-277 V AC 60 Hz), consumption below 500 VA, automatic spring charging, padlocking still possible, supplied with an SDE adapter. Motor terminals M1-M2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">Motor mechanism module MT250, ComPacT NSX250, 220/240 V AC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">LV431541</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation><elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary2" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation><elementInformation name="designation_auxiliary2" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">29450</elementInformation><elementInformation name="quantity_auxiliary2" show="0">0</elementInformation><elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary3" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary3" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429410</elementInformation><elementInformation name="quantity_auxiliary3" show="0">0</elementInformation><elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation><elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation><elementInformation name="quantity_auxiliary4" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-55" y="493" rotation_point_center="false" uuid="{4b685f34-3e95-529f-864f-28eea9fabf6c}"><text>-Q6</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_nsx/nsx250n_3p_tm250/nsx250n_3p_tm250_realistic.elmt" uuid="{ba785bd3-5f5c-5ad2-9312-d6ab7e9ced98}" x="980" y="120" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="430" /><terminal id="2" orientation="n" x="120" y="0" /><terminal id="3" orientation="s" x="120" y="430" /><terminal id="4" orientation="n" x="240" y="0" /><terminal id="5" orientation="s" x="240" y="430" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-Q7</elemen