				<column index="1" visible="false"/>
				<column index="2" visible="false"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
			</columnVisibility>
			<plcIOs>
				<plcIO address="Q1" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="Q3" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>3</terminal>
				</plcIO>
				<plcIO address="Q2" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>5</terminal>
				</plcIO>
				<plcIO address="Q4" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>7</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
	</kindInformations>
