		<elementInformation name="unity" show="0">pcs</elementInformation>
		<elementInformation name="width" show="0">207</elementInformation>
		<elementInformation name="height" show="0">125</elementInformation>
		<elementInformation name="depth" show="0">41</elementInformation>
		<elementInformation name="auxiliary1" show="0">Power plug</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">3-way screw terminal plug for FG, 0 V and 24 V</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">Power plug</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">1</elementInformation>
		<elementInformation name="unity_auxiliary1" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary2" show="0">DB9 plug</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">DB9 plug for a COM port cable</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">DB9 plug</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">4</elementInformation>
		<elementInformation name="unity_auxiliary2" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary3" show="0">RJ45 plug</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">RJ45 plug for the Ethernet cable</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">RJ45 plug</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">1</elementInformation>
		<elementInformation name="unity_auxiliary3" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary4" show="0">USB cable</elementInformation>
		<elementInformation name="description_auxiliary4" show="0">USB cable for the host or slave port</elementInformation>
		<elementInformation name="designation_auxiliary4" show="0">USB cable</elementInformation>
		<elementInformation name="quantity_auxiliary4" show="0">1</elementInformation>
