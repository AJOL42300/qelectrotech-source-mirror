                <category name="m12_y_distributor">
                    <names>
                        <name lang="en">M12 Y distributors for valves</name>
                        <name lang="fr">Répartiteurs Y M12 pour électrovannes</name>
                        <name lang="de">M12 Y-Verteiler für Ventile</name>
