<definition version="0.100.0" type="element" link_type="master" width="120" height="90" hotspot_x="10" hotspot_y="30">
	<uuid uuid="{3d31588c-6cdf-5fe7-a054-b4bbfe663a97}"/>
	<names>
		<name lang="en">Pilz 540003 PSEN cs1.1n coded safety switch with 5-pin M12 male connector</name>
		<name lang="fr">Interrupteur de sécurité codé PSEN cs1.1n Pilz 540003 avec connecteur M12 mâle 5 broches</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Pilz</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">540003</elementInformation>
		<elementInformation name="designation" show="1">Interrupteur de sécurité codé RFID PSEN cs1.1n, 2 sorties de sécurité à semi-conducteurs, connecteur M12 mâle 5 broches, 24 V DC</elementInformation>
		<elementInformation name="description" show="1">PSEN cs1.1n / PSEN cs1.1 coded RFID safety switch with actuator, 2 safe semiconductor outputs, 5-pin M12 male connector, 24 V DC, IP67. VERIFIED (Pilz e-shop page of 540003 and the Pilz operating manual of the PSEN cs1.1n): pin 1 A1 +24 V UB brown, pin 2 terminal 12 output channel 1 white, pin 3 A2 0 V UB blue, pin 4 terminal 22 output channel 2 black, pin 5 grey do not connect (no terminal). The colours are those of the Pilz accessory cable.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
