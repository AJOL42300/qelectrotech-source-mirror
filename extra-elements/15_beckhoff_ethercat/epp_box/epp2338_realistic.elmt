	<names>
		<name lang="en">EPP2338 EtherCAT P box, 8 channels, realistic view</name>
		<name lang="fr">EPP2338 boîtier EtherCAT P, 8 voies, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EPP2338-0001</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT P Box, 8-channel digital combi, 24 V DC, 10 us, 0.5 A, M8</elementInformation>
		<elementInformation name="description" show="1">EtherCAT P box with four M8 sockets X01 to X04, two channels each, EtherCAT P IN X50 and OUT X51. Schematic view: one block per socket, pins named after the socket (X01.1 to X04.4, the pin order assumed for a 4-pin M8 socket: 1 +24 V, 2 channel 2, 3 0 V, 4 channel 1; check it in the datasheet). The channel (X01(1)...) is the signal in the I/O table, not the pin. The label of the box is the card id (A1.10).</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
