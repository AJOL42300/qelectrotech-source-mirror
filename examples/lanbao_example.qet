                            <definition height="80" hotspot_x="10" hotspot_y="30" link_type="simple" type="element" version="0.100.0" width="60">
	<uuid uuid="{73966f82-d792-56af-bbc8-5b9171c08eb1}"/>
	<names>
		<name lang="en">Lanbao PDB-CC50TGI laser distance sensor, layout (1 px = 2 mm)</name>
		<name lang="fr">Capteur de distance laser Lanbao PDB-CC50TGI, implantation (1 px = 2 mm)</name>
	</names>
	<elementInformations>
