	<uuid uuid="{a2ba6a02-a58c-5938-bf4e-4ce4c92c7386}"/>
	<names>
		<name lang="en">AF1103 servo drive, 1 axis</name>
		<name lang="fr">AF1103 variateur, 1 axe(s)</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">AF1103</elementInformation>
		<elementInformation name="designation" show="1">AF1103 servo drive, 1 axis</elementInformation>
		<elementInformation name="description" show="1">AF 1-axis drive (the second digit of the reference is the number of axes). Rating from the project nomenclature: 0.37 kW, 1.6 A. Redrawn in vector from a picture of the project, terminals snapped to the 10 px grid. Mains terminals drawn as 3-phase L1 L2 L3 PE RB+ RB-; the 1-phase version (L N PE RB+ RB-) is not drawn. 24V_A..C are the '25 Vdc' of a blurry picture, read as 24 V. Check against the datasheet.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
