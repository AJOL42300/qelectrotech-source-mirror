				</plcIO>
				<plcIO type="sortie_digitale" address="P2-" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>6</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="P3-" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>7</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="P4-" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>8</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
