                <element name="el1008_table.elmt">
                    <definition height="154" hotspot_x="5" hotspot_y="29" link_type="master" type="element" version="0.100.0" width="390">
	<uuid uuid="{2b2e538b-a010-50e2-91e3-767d01ef33d7}"/>
	<names>
		<name lang="en">EL1008 digital input terminal (generic) - I/O table</name>
		<name lang="fr">EL1008 borne d'entrée numérique (générique) - tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL1008</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 8-channel digital input, 24 V DC, 3 ms</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital input terminal. Generic layout: contacts 1 to 8; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 8 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="5" visible="true"/>
			</columnVisibility>
			<plcIOs>
				<plcIO address="I1" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="I2" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>5</terminal>
				</plcIO>
				<plcIO address="I3" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>2</terminal>
				</plcIO>
				<plcIO address="I4" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>6</terminal>
				</plcIO>
				<plcIO address="I5" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
