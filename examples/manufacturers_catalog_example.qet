		<elementInformation name="manufacturer_reference" show="1">LC1D32P7</elementInformation>
		<elementInformation name="designation" show="1">TeSys D contactor, 3P, 32 A AC-3, 230 V AC coil, 1 NO + 1 NC</elementInformation>
		<elementInformation name="description" show="1">TeSys D contactor LC1D32P7, 3 poles, 32 A AC-3 (15 kW at 400 V), coil 230 V AC 50/60 Hz, 1 NO + 1 NC auxiliary contact built in, screw clamp terminals, 45 mm wide. Terminals 1/L1-2/T1, 3/L2-4/T2, 5/L3-6/T3, coil A1-A2, auxiliary 13-14 (NO) and 21-22 (NC).</elementInformation>
		<elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">Front-mounting instantaneous auxiliary contact block LADN22 for TeSys D (LC1D) and TeSys F contactors, 2 NO + 2 NC, screw clamp terminals. Terminal marking 53-54, 61-62, 71-72, 83-84.</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">TeSys D front auxiliary contact block LADN22, 2 NO + 2 NC, screw clamp</elementInformation>
