	<names>
		<name lang="en">EL2574 LED output terminal, realistic view</name>
		<name lang="fr">EL2574 borne de sortie LED, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2574</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 4-channel output, labels as drawn</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, LED output terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 P1+, 2 P2+, 3 P3+, 4 P4+, 5 P1-, 6 P2-, 7 P3-, 8 P4-. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
