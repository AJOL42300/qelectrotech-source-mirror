                <inputs/>
                <elementInformations>
                    <elementInformation name="auxiliary1" show="0">EtherCAT cable X04/X05</elementInformation>
                    <elementInformation name="auxiliary2" show="0">Motor plug X13</elementInformation>
                    <elementInformation name="auxiliary3" show="0">I/O plug X03</elementInformation>
                    <elementInformation name="auxiliary4" show="0">Mains plug X01</elementInformation>
                    <elementInformation name="description_auxiliary1" show="0">EtherCAT patch cable, RJ45 to RJ45, green PUR, Cat.5. The last digits of the reference give the length (for example 0010 = 1 m). One cable counted for the IN port; the cable of the OUT port belongs to the next device.</elementInformation>
                    <elementInformation name="description_auxiliary2" show="0">4-pin plug U V W PE, pitch 7.62 mm, push-in, for the slot X13/X23, three-phase supply version, sold by 10 (PU 10); one plug per axis. The single-phase supply version is ZS4100-1113 (pitch 5.08 mm).</elementInformation>
                    <elementInformation name="description_auxiliary3" show="0">Plug of the X03 terminal strip (IN1..IN6, GND, TH, OUT, FGND, 24V). Reference NOT identified on the public Beckhoff pages: to be completed from the AF1000 documentation.</elementInformation>
                    <elementInformation name="description_auxiliary4" show="0">Plug of the X01 terminal strip (L1 L2 L3 PE RB+ RB-). Reference NOT identified on the public Beckhoff pages: to be completed from the AF1000 documentation.</elementInformation>
                    <elementInformation name="designation" show="0">AF1103 servo drive, 1 axis</elementInformation>
                    <elementInformation name="designation_auxiliary1" show="0">EtherCAT patch cable</elementInformation>
