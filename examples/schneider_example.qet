ame="description" show="1">RCCB iID, 4P, 40 A, 30 mA, type AC, instantaneous. Neutral on the left (N1-N2). Width 8 x 9 mm (72 mm), height 85-91 mm, depth 69-73.5 mm.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Acti9 iOF open/close auxiliary contact (also fault indication), 1 changeover (1 NO + 1 NC), 6 A at 240 V AC, 9 mm wide, for iC60, iID, iDPN Vigi and iSW 40-125 (public compatibility list). Terminals C, NC, NO ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">iOF auxiliary contact, Acti9, 1 changeover, AC/DC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">A9A26924</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{641f1ae0-e630-5529-9c9b-198a923c084a}"><text>-F3</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/acti9_rcd/vigi_ic60_3p/vigi_ic60_3p.elmt" uuid="{b8c484bc-e2b2-5462-b91d-61a1088326d4}" x="1200" y="150" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="n" x="30" y="0" /><terminal id="3" orientation="s" x="30" y="60" /><terminal id="4" orientation="n" x="60" y="0" /><terminal id="5" orientation="s" x="60" y="60" /></terminals><inputs /><elemen