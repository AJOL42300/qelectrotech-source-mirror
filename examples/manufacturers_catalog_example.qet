	<uuid uuid="{4c94c32a-5fcc-5a55-9520-d9524d17d4db}"/>
	<names>
		<name lang="en">EL1004 digital input terminal, realistic view</name>
		<name lang="fr">EL1004 borne d'entrée numérique, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL1004</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 4-channel digital input, 24 V DC, 3 ms</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital input terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 I1, 2 0V1, 3 I3, 4 0V3, 5 I2, 6 0V2, 7 I4, 8 0V4. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false"/>
				<column index="1" visible="false"/>
				<column index="2" visible="false"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
			</columnVisibility>
			<plcIOs>
				<plcIO address="I1" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="I3" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>3</terminal>
				</plcIO>
				<plcIO address="I2" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>5</terminal>
				</plcIO>
				<plcIO address="I4" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>7</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
	</kindInformations>
