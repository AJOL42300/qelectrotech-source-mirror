	<names>
		<name lang="en">AX5201 servo drive, 2 axis - generic</name>
		<name lang="fr">AX5201 variateur, 2 axe(s) - générique</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">AX5201</elementInformation>
		<elementInformation name="designation" show="1">AX5201 digital compact servo drive, 2 axes</elementInformation>
		<elementInformation name="description" show="1">AX 2-axes drive (the second digit of the reference is the number of axes). Rating from the project nomenclature: 2 x 1.5 A. Redrawn in vector from a picture of the project, terminals snapped to the 10 px grid. The motor and brake connectors are not on the pictures: the Motor terminals are generic, under the body. X06 function names are generic (0..7).</elementInformation>
	</elementInformations>
