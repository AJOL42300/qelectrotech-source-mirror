<project title="Hierarchical BOM example" uuid="{c4ea632c-0f0a-5609-8808-bd788a7d3fcf}" version="0.200.1">
    <titleblocktemplates>
        <titleblocktemplate name="A3 landscape">
			<information>Two-row strip for an A3 landscape folio. The first cell is left empty for a logo.</information>
			<logos/>
			<grid cols="100px;r25%;r50%;r25%;" rows="25;25;">
				<field align="left" col="1" displaylabel="true" hadjust="true" name="author" row="0" valign="center">
					<value>
						<translation lang="en">%author</translation>
					</value>
					<label>
						<translation lang="en">Author</translation>
						<translation lang="fr">Auteur</translation>
						<translation lang="de">Autor</translation>
						<translation lang="es">Autor</translation>
						<translation lang="it">Autore</translation>
					</label>
				</field>
				<field align="center" col="2" displaylabel="false" hadjust="true" name="title" row="0" valign="center">
					<value>
						<translation lang="en">%projecttitle</translation>
					</value>
					<label>
						<translation lang="en">Title</translation>
						<translation lang="fr">Titre</translation>
						<translation lang="de">Titel</translation>
						<translation lang="es">Título</translation>
						<translation lang="it">Titolo</translation>
					</label>
				</field>
				<field align="left" col="3" displaylabel="true" hadjust="true" name="file" row="0" valign="center">
					<value>
						<translation lang="en">%savedfilename</translation>
					</value>
					<label>
						<translation lang="en">File</translation>
						<translation lang="fr">Fichier</translation>
						<translation lang="de">Datei</translation>
						<translation lang="es">Archivo</translation>
						<translation lang="it">File</translation>
					</label>
				</field>
				<field align="left" col="1" displaylabel="true" hadjust="true" name="date" row="1" valign="center">
					<value>
						<translation lang="en">%date</translation>
					</value>
					<label>
						<translation lang="en">Date</translation>
						<translation lang="fr">Date</translation>
						<translation lang="de">Datum</translation>
						<translation lang="es">Fecha</translation>
						<translation lang="it">Data</translation>
					</label>
				</field>
				<field align="center" col="2" displaylabel="false" fontsize="9" hadjust="true" name="" row="1" valign="center">
					<value>
						<translation lang="en">%title</translation>
					</value>
					<label/>
				</field>
				<field align="left" col="3" displaylabel="true" hadjust="true" name="folio" row="1" valign="center">
					<value>
						<translation lang="en">%{folio-id} of %{folio-total}</translation>
						<translation lang="fr">%{folio-id} sur %{folio-total}</translation>
					</value>
					<label>
						<translation lang="en">Folio</translation>
						<translation lang="fr">Folio</translation>
						<translation lang="de">Blatt</translation>
						<translation lang="es">Hoja</translation>
						<translation lang="it">Foglio</translation>
					</label>
				</field>
			</grid>
		</titleblocktemplate>
        <titleblocktemplate name="A3 portrait">
			<information>Two-row strip for an A3 portrait folio. The first cell is left empty for a logo.</information>
