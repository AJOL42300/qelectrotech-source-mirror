	<names>
		<name lang="en">EL5152 encoder input terminal (generic) - I/O table</name>
		<name lang="fr">EL5152 borne d'entrée codeur (générique) - tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL5152</elementInformation>
		<elementInformation name="designation" show="1">EL5152 EtherCAT Terminal</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, two incremental encoder inputs A/B. Terminals numbered in the Beckhoff order, as in the user's drawing: 1 A1, 2 +, 3 -, 4 A2 on the left; 5 B1, 6 +, 7 -, 8 B2 on the right. Check against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="5" visible="true"/>
			</columnVisibility>
			<plcIOs>
				<plcIO type="entree_digitale" address="A1" functionText="Encoder 1, A" comment="" crossRef="" terminalCount="1">
					<terminal>1</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="B1" functionText="Encoder 1, B" comment="" crossRef="" terminalCount="1">
					<terminal>5</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="A2" functionText="Encoder 2, A" comment="" crossRef="" terminalCount="1">
					<terminal>4</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="B2" functionText="Encoder 2, B" comment="" crossRef="" terminalCount="1">
					<terminal>8</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
	</kindInformations>
