	<names>
		<name lang="en">EL6910 TwinSAFE Logic Terminal</name>
		<name lang="fr">EL6910 TwinSAFE Logic Terminal</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL6910</elementInformation>
		<elementInformation name="designation" show="1">TwinSAFE Logic Terminal</elementInformation>
		<elementInformation name="description" show="1">TwinSAFE logic terminal, no field terminals and no terminal drawn. Power contacts (24 V / 0 V) drawn as the pass-through of the series: ASSUMED, the datasheet gives "current consumption power contacts: -".</elementInformation>
	</elementInformations>
