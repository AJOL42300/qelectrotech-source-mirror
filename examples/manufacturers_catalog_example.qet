	<uuid uuid="{e5316fe9-e4d1-58e3-b249-4e8fb72a5c06}"/>
	<names>
		<name lang="en">M2100E HMI M2, 10.1 in, 1024 x 600, Ethernet, description view</name>
		<name lang="fr">M2100E IHM M2, 10.1 pouces, 1024 x 600, Ethernet, vue description</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Kinco</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">M2100E</elementInformation>
		<elementInformation name="designation" show="1">HMI M2, 10.1 in, 1024 x 600, Ethernet</elementInformation>
		<elementInformation name="description" show="1">Kinco HMI M2 series M2100E, 10.1 inch 1024 x 600 operator panel. Panel cut-out (W x H): 260 x 179 mm, verified, source: https://kincoautomation.ru/en/product/automation/m2/mass-series-2-m2-m2100e-11863. The terminals are the power plug, the COM ports (pin number and signal), Ethernet and the USB ports; the pinout is the one of the MT070 / GL070E manuals and is assumed identical on this model, check it against the datasheet.</elementInformation>
		<elementInformation name="quantity" show="0">1</elementInformation>
		<elementInformation name="unity" show="0">pcs</elementInformation>
		<elementInformation name="width" show="0">271</elementInformation>
		<elementInformation name="height" show="0">191</elementInformation>
		<elementInformation name="depth" show="0">36</elementInformation>
		<elementInformation name="auxiliary1" show="0">Power plug</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">3-way screw terminal plug for 24 V, 0 V and FG</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">Power plug</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">1</elementInformation>
		<elementInformation name="unity_auxiliary1" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary2" show="0">DB9 plug</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">DB9 plug for a COM0 or COM2 port cable</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">DB9 plug</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">2</elementInformation>
		<elementInformation name="unity_auxiliary2" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary3" show="0">COM1 plug</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">2-pin plug for the RS485 cable of COM1</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">COM1 plug</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">1</elementInformation>
		<elementInformation name="unity_auxiliary3" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary4" show="0">RJ45 plug</elementInformation>
		<elementInformation name="description_auxiliary4" show="0">RJ45 plug for the Ethernet cable</elementInformation>
		<elementInformation name="designation_auxiliary4" show="0">RJ45 plug</elementInformation>
		<elementInformation name="quantity_auxiliary4" show="0">1</elementInformation>
		<elementInformation name="unity_auxiliary4" show="0">pcs</elementInformation>
		<elementInformation name="auxiliary5" show="0">USB cable</elementInformation>
