	<uuid uuid="{207fc392-2c8b-5658-ab67-cd2cdf668bdf}" />
	<names>
		<name lang="en">TeSys D contactor LC1D09BD 9 A 24 V DC, front view</name>
		<name lang="fr">Contacteur TeSys D LC1D09BD 9 A 24 V CC, vue de face</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">LC1D09BD</elementInformation>
		<elementInformation name="designation" show="1">TeSys D contactor, 3P, 9 A AC-3, 24 V DC coil, 1 NO + 1 NC</elementInformation>
		<elementInformation name="description" show="1">TeSys D contactor LC1D09BD, 3 poles, 9 A AC-3 (4 kW at 400 V), coil 24 V DC, 1 NO + 1 NC auxiliary contact built in, screw clamp terminals, 45 x 77 x 95 mm. Terminals 1/L1-2/T1, 3/L2-4/T2, 5/L3-6/T3, coil A1-A2, auxiliary 13-14 (NO) and 21-22 (NC).</elementInformation>
		<elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">Front-mounting instantaneous auxiliary contact block LADN22 for TeSys D (LC1D) and TeSys F contactors, 2 NO + 2 NC, screw clamp terminals. Terminal marking 53-54, 61-62, 71-72, 83-84.</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">TeSys D front auxiliary contact block LADN22, 2 NO + 2 NC, screw clamp</elementInformation>
		<elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary1" show="0">LADN22</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">0</elementInformation>
		<elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">Front-mounting instantaneous auxiliary contact block LADN11 for TeSys D (LC1D) and TeSys F contactors, 1 NO + 1 NC, screw clamp terminals. Terminal marking 53-54, 61-62. ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">TeSys D front auxiliary contact block LADN11, 1 NO + 1 NC, screw clamp</elementInformation>
		<elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary2" show="0">LADN11</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">0</elementInformation>
		<elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">Front-mounting instantaneous auxiliary contact block LADN20 for TeSys D (LC1D) and TeSys F contactors, 2 NO, screw clamp terminals. Terminal marking 53-54, 83-84. ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">TeSys D front auxiliary contact block LADN20, 2 NO, screw clamp</elementInformation>
		<elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary3" show="0">LADN20</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">0</elementInformation>
		<elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary4" show="0">Front-mounting instantaneous auxiliary contact block LADN02 for TeSys D (LC1D) and TeSys F contactors, 2 NC, screw clamp terminals. Terminal marking 61-62, 71-72. ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary4" show="0">TeSys D front auxiliary contact block LADN02, 2 NC, screw clamp</elementInformation>
		<elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary4" show="0">LADN02</elementInformation>
		<elementInformation name="quantity_auxiliary4" show="0">0</elementInformation>
	</elementInformations>
