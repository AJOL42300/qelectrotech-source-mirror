                                <element name="el2522_table.elmt">
                                    <definition height="154" hotspot_x="5" hotspot_y="29" link_type="master" type="element" version="0.100.0" width="250">
	<uuid uuid="{5243dd64-efed-55d5-8a4c-caa182e65643}"/>
	<names>
		<name lang="en">EL2522 pulse train output terminal - I/O table</name>
		<name lang="fr">EL2522 borne de sortie train d'impulsions - tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2522</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 2-channel pulse train output</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, pulse train output terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 CH1A, 2 CH1C, 3 CH2A, 4 CH2C, 5 CH1B, 6 CH1D, 7 CH2B, 8 CH2D. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="12.00">
			<columnWidths>
				<column index="0" width="60"/>
				<column index="1" width="66"/>
				<column index="2" width="130"/>
				<column index="3" width="90"/>
				<column index="4" width="64"/>
				<column index="5" width="44"/>
			</columnWidths>
			<columnVisibility>
				<column index="0" visible="false"/>
				<column index="1" visible="true"/>
				<column index="2" visible="true"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
				<column index="5" visible="true"/>
			</columnVisibility>
			<columnNames>
				<column index="0"/>
				<column index="1">ID TwinCAT</column>
				<column index="2">Label</column>
				<column index="3"/>
				<column index="4"/>
				<column index="5">N° pin</column>
			</columnNames>
			<columnOrder>5,2,1</columnOrder>
			<headerFont bold="true" family="Roboto Condensed" size="7"/>
			<cellFont bold="false" family="Roboto Condensed" size="7"/>
			<plcIOs>
				<plcIO address="CH1A" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="CH1C" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>2</terminal>
				</plcIO>
				<plcIO address="CH2A" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
