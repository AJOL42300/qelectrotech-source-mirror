                                <element name="ax5103_description.elmt">
                                    <definition height="250" hotspot_x="100" hotspot_y="120" link_type="master" type="element" version="0.100.0" width="240">
	<uuid uuid="{0eb63c81-8723-5ef5-ad41-a55b8916eee7}"/>
	<names>
		<name lang="en">AX5103 servo drive, 1 axis - realistic view</name>
		<name lang="fr">AX5103 variateur, 1 axe(s) - vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">AX5103</elementInformation>
		<elementInformation name="designation" show="1">AX5103 digital compact servo drive, 1 axis</elementInformation>
		<elementInformation name="description" show="1">AX 1-axis drive (the second digit of the reference is the number of axes). Rating from the project nomenclature: 3 A. Redrawn in vector from a picture of the project, terminals snapped to the 10 px grid. The motor and brake connectors are not on the pictures: the Motor terminals are generic, under the body. X06 function names are generic (0..7).</elementInformation>
		<elementInformation name="auxiliary1" show="1">Mains plug X01</elementInformation>
		<elementInformation name="description_auxiliary1" show="1">4-pin socket, pitch 7.62 mm, max. 6 mm2, for 1.5 to 25 A. Included in the scope of supply of the drive, also in the connector set ZS4500-2010.</elementInformation>
		<elementInformation name="manufacturer_auxiliary1" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary1" show="1">ZS4500-2001</elementInformation>
