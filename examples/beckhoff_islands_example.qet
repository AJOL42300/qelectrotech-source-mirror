		<elementInformation name="manufacturer_reference" show="1">EL1008</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 8-channel digital input, 24 V DC, 3 ms</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital input terminal. Generic layout: contacts 1 to 8; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 8 contacts: edit it in the element properties.</elementInformation>
