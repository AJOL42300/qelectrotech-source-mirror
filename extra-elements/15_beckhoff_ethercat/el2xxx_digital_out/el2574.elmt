	<names>
		<name lang="en">EL2574 LED output terminal</name>
		<name lang="fr">EL2574 borne de sortie LED</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2574</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 4-channel output, labels as drawn</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, LED output terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 P1+, 2 P2+, 3 P3+, 4 P4+, 5 P1-, 6 P2-, 7 P3-, 8 P4-. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false"/>
				<column index="1" visible="false"/>
				<column index="2" visible="false"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
			</columnVisibility>
			<plcIOs>
				<plcIO type="sortie_digitale" address="P1+" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>1</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="P2+" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>2</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="P3+" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>3</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="P4+" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>4</terminal>
