	<diagram author="" auto_page_num="" cols="20" colsize="61" date="null" displayAt="bottom" displaycols="true" displayrows="true" filename="" folio="%id/%total" freezeNewConductor="false" freezeNewElement="false" height="820" indexrev="" locmach="" order="4" plant="" rows="10" rowsize="80" title="Hierarchical bill of materials" titleblocktemplate="A3 landscape" titleblocktemplateCollection="embedded" uuid="{ef449590-b29d-5c01-85ac-bf6ca54b010f}" version="0.200.1-dev">
		<defaultconductor bicolor="false" bus="" cable="" color2="#000000" condsize="1" conductor_color="" conductor_section="" dash-size="1" displaytext="1" formula="" function="" horizontal-alignment="AlignBottom" horizrotatetext="0" num="_" numsize="7" onetextperfolio="0" tension_protocol="" text_color="#000000" type="multi" vertical-alignment="AlignRight" vertirotatetext="270" />
		<elements />
		<conductors />
		<inputs />
		<tables>
			<graphics_table x="10" y="10" width="1180" height="640" uuid="{879fad88-0d51-5973-b168-02d044a88d37}" name="Hierarchical BOM" display_n_row="0">
				<graphics_header>
					<margins>5;5;5;5</margins>
				</graphics_header>
				<model>
					<project_data_base_model>
						<identifier>nomenclature</identifier>
						<query>WITH RECURSIVE bom_blocks(blk) AS (VALUES (0), (1), (2), (3), (4)), bom_elem AS (SELECT ROW_NUMBER() OVER (ORDER BY diagram_position, position, label) AS eid, v.* FROM element_nomenclature_view v), bom_art AS (SELECT e.eid AS eid, b.blk AS blk, TRIM(COALESCE(e.label, '')) AS label, TRIM(COALESCE(CASE b.blk WHEN 0 THEN e.manufacturer WHEN 1 THEN e.manufacturer_auxiliary1 WHEN 2 THEN e.manufacturer_auxiliary2 WHEN 3 THEN e.manufacturer_auxiliary3 WHEN 4 THEN e.manufacturer_auxiliary4 END, '')) AS manufacturer, TRIM(COALESCE(CASE b.blk WHEN 0 THEN e.manufacturer_reference WHEN 1 THEN e.manufacturer_reference_auxiliary1 WHEN 2 THEN e.manufacturer_reference_auxiliary2 WHEN 3 THEN e.manufacturer_reference_auxiliary3 WHEN 4 THEN e.manufacturer_reference_auxiliary4 END, '')) AS article, COALESCE(NULLIF(TRIM(CASE b.blk WHEN 0 THEN e.description WHEN 1 THEN e.description_auxiliary1 WHEN 2 THEN e.description_auxiliary2 WHEN 3 THEN e.description_auxiliary3 WHEN 4 THEN e.description_auxiliary4 END), ''), CASE b.blk WHEN 0 THEN e.designation WHEN 1 THEN e.designation_auxiliary1 WHEN 2 THEN e.designation_auxiliary2 WHEN 3 THEN e.designation_auxiliary3 WHEN 4 THEN e.designation_auxiliary4 END, '') AS name, TRIM(COALESCE(CASE b.blk WHEN 0 THEN e.unity WHEN 1 THEN e.unity_auxiliary1 WHEN 2 THEN e.unity_auxiliary2 WHEN 3 THEN e.unity_auxiliary3 WHEN 4 THEN e.unity_auxiliary4 END, '')) AS unit, CAST(REPLACE(COALESCE(NULLIF(TRIM(CASE b.blk WHEN 0 THEN e.quantity WHEN 1 THEN e.quantity_auxiliary1 WHEN 2 THEN e.quantity_auxiliary2 WHEN 3 THEN e.quantity_auxiliary3 WHEN 4 THEN e.quantity_auxiliary4 END), ''), '1'), ',', '.') AS REAL) AS qty, CAST(REPLACE(COALESCE(NULLIF(TRIM(e.quantity), ''), '1'), ',', '.') AS REAL) AS main_qty FROM bom_elem e, bom_blocks b WHERE (TRIM(COALESCE(CASE b.blk WHEN 0 THEN e.manufacturer_reference WHEN 1 THEN e.manufacturer_reference_auxiliary1 WHEN 2 THEN e.manufacturer_reference_auxiliary2 WHEN 3 THEN e.manufacturer_reference_auxiliary3 WHEN 4 THEN e.manufacturer_reference_auxiliary4 END, '')) &lt;&gt; '' OR TRIM(COALESCE(CASE b.blk WHEN 0 THEN e.designation WHEN 1 THEN e.designation_auxiliary1 WHEN 2 THEN e.designation_auxiliary2 WHEN 3 THEN e.designation_auxiliary3 WHEN 4 THEN e.designation_auxiliary4 END, '')) &lt;&gt; '' OR TRIM(COALESCE(CASE b.blk WHEN 0 THEN e.description WHEN 1 THEN e.description_auxiliary1 WHEN 2 THEN e.description_auxiliary2 WHEN 3 THEN e.description_auxiliary3 WHEN 4 THEN e.description_auxiliary4 END, '')) &lt;&gt; '')), bom_nodes AS (SELECT label, MIN(eid) AS first_eid FROM bom_art GROUP BY label), bom_link AS (SELECT n.label AS label, n.first_eid AS first_eid, COALESCE((SELECT a.qty FROM bom_art a WHERE a.label = n.label AND a.blk = 0 ORDER BY a.eid LIMIT 1), 1) AS own_qty, (SELECT p.label FROM bom_nodes p WHERE p.label &lt;&gt; '' AND length(p.label) + 1 &lt; length(n.label) AND substr(n.label, 1, length(p.label)) = p.label AND substr(n.label, length(p.label) + 1, 1) IN ('.', '-', '_') ORDER BY length(p.label) DESC LIMIT 1) AS parent FROM bom_nodes n), bom_ranked AS (SELECT label, parent, own_qty, ROW_NUMBER() OVER (ORDER BY first_eid) AS rk FROM bom_link), bom_hierarchy_tree(label, depth, path, mult, own_qty) AS (SELECT label, 0, printf('%06d', rk), 1.0, own_qty FROM bom_ranked WHERE parent IS NULL UNION ALL SELECT r.label, t.depth + 1, t.path || '/' || printf('%06d', r.rk), t.mult * t.own_qty, r.own_qty FROM bom_ranked r JOIN bom_hierarchy_tree t ON r.parent = t.label) SELECT t.depth + (CASE WHEN a.blk &gt; 0 THEN 1 ELSE 0 END) AS level, a.label AS label, a.qty AS quantity, t.mult * (CASE WHEN a.blk &gt; 0 THEN a.main_qty ELSE 1 END) * a.qty AS total_quantity, printf('%*s%s', 2 * (t.depth + (CASE WHEN a.blk &gt; 0 THEN 1 ELSE 0 END)), '', a.name) AS name, a.article AS part_number, a.manufacturer AS manufacturer, a.unit AS unit, CASE WHEN t.depth = 0 AND a.blk = 0 AND LTRIM(a.label, '=+-') GLOB '*[A-Za-z0-9][-._][A-Za-z0-9]*' THEN 1 ELSE 0 END AS orphan FROM bom_art a JOIN bom_hierarchy_tree t ON t.label = a.label ORDER BY t.path, a.eid, a.blk</query>
						<index00 font="Liberation Sans,9,-1,5,50,0,0,0,0,0" alignment="AlignLeft|AlignVCenter" margins="5;5;5;5" />
						<header_data>
							<data section="0" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="0" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="1" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="1" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="2" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="2" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="3" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="3" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="4" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="4" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="5" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="5" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="6" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="6" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="7" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="7" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
							<data section="8" orientation="Horizontal" role="FontRole">Liberation Sans,9,-1,5,75,0,0,0,0,0</data>
							<data section="8" orientation="Horizontal" role="TextAlignmentRole">AlignCenter</data>
						</header_data>
					</project_data_base_model>
				</model>
			</graphics_table>
		</tables>
