		<elementInformation name="manufacturer_reference" show="1">9000-41068-0600000</elementInformation>
		<elementInformation name="designation" show="1">8-channel electronic circuit breaker, 24 V DC, 8 x 6 A</elementInformation>
		<elementInformation name="description" show="1">one push button with integrated status LED per channel; group alarm contact on terminals 13-14 (potential-free); no separate 0 V output terminal per channel (assumed)</elementInformation>
	</elementInformations>
