ntInformation><elementInformation name="designation_auxiliary2" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">29450</elementInformation><elementInformation name="quantity_auxiliary2" show="0">0</elementInformation><elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary3" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary3" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429410</elementInformation><elementInformation name="quantity_auxiliary3" show="0">0</elementInformation><elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation><elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation><elementInformation name="quantity_auxiliary4" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" ke