	<uuid uuid="{c1f2d113-7005-5e82-9ce0-d82deaf168e8}"/>
	<names>
		<name lang="en">EL1918 EtherCAT Terminal, 8 fail-safe digital inputs, 24 V DC, description view</name>
		<name lang="fr">EL1918 EtherCAT Terminal, 8 fail-safe digital inputs, 24 V DC, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL1918</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 8 fail-safe digital inputs, 24 V DC</elementInformation>
		<elementInformation name="description" show="1">TwinSAFE input terminal with 16 terminals: for each input n, a clock output Sn+ and a safe input SIn (terminal Sn-). The order is 1, 3, 5, 7, 2, 4, 6, 8 (terminals 1 to 16). 16 terminals (user request, public Beckhoff list). The terminal order is documented, the physical arrangement (rows of two) is an assumption: check it before use.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false"/>
				<column index="1" visible="false"/>
				<column index="2" visible="false"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
			</columnVisibility>
			<plcIOs>
				<plcIO address="SI1" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>2</terminal>
				</plcIO>
				<plcIO address="SI2" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>10</terminal>
				</plcIO>
				<plcIO address="SI3" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>4</terminal>
				</plcIO>
				<plcIO address="SI4" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>12</terminal>
				</plcIO>
				<plcIO address="SI5" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>6</terminal>
				</plcIO>
				<plcIO address="SI6" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>14</terminal>
				</plcIO>
				<plcIO address="SI7" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>8</terminal>
				</plcIO>
				<plcIO address="SI8" comment="" crossRef="" functionText="" terminalCount="1" type="entree_digitale">
					<terminal>16</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
