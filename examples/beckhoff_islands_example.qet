</definition></element><element name="el1918_realistic.elmt"><definition version="0.100.0" type="element" link_type="master" width="60" height="330" hotspot_x="30" hotspot_y="160">
	<uuid uuid="{e8e5d813-0744-5036-a1c0-60eb33e0bfc0}" />
	<names>
		<name lang="en">EL1918 EtherCAT Terminal, 8 fail-safe digital inputs, 24 V DC, realistic view</name>
		<name lang="fr">EL1918 EtherCAT Terminal, 8 fail-safe digital inputs, 24 V DC, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL1918</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 8 fail-safe digital inputs, 24 V DC</elementInformation>
		<elementInformation name="description" show="1">TwinSAFE input terminal with 16 terminals: for each input n, a clock output Sn+ and a safe input SIn (terminal Sn-). The order is 1, 3, 5, 7, 2, 4, 6, 8 (terminals 1 to 16). 16 terminals (user request, public Beckhoff list). The terminal order is documented, the physical arrangement (rows of two) is an assumption: check it before use.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false" />
				<column index="1" visible="false" />
				<column index="2" visible="false" />
				<column index="3" visible="false" />
				<column index="4" visible="false" />
			</columnVisibility>
			<plcIOs>
				<plcIO type="entree_digitale" address="SI1" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>2</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="SI2" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>10</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="SI3" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>4</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="SI4" functionText="" comment="" crossRef="" terminalCount="1">
