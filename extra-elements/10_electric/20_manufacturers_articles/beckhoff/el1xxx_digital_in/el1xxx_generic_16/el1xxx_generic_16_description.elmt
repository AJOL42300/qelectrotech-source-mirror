		<elementInformation name="designation" show="1">EL1xxx</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital input terminal. Generic layout: contacts 1 to 16; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 16 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
