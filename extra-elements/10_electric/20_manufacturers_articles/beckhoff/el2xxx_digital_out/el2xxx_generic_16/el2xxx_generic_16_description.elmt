	<names>
		<name lang="en">EL2xxx digital output terminal (generic, 16 terminals), description view</name>
		<name lang="fr">EL2xxx borne de sortie numérique (générique, 16 bornes), vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="designation" show="1">EL2xxx</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital output terminal. Generic layout: contacts 1 to 16; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 16 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
