	<uuid uuid="{924e0ec8-808b-5123-a628-2e5a0071cace}"/>
	<names>
		<name lang="en">KS105-16DT Compact PLC, 8 DI, 8 DO, RS232, RS485</name>
		<name lang="fr">KS105-16DT Automate compact, 8 E TOR, 8 S TOR, RS232, RS485</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Kinco</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">KS105-16DT</elementInformation>
		<elementInformation name="designation" show="1">Compact PLC, 8 DI, 8 DO, RS232, RS485</elementInformation>
		<elementInformation name="description" show="1">Kinco KS105 compact PLC, 8 digital inputs and 8 transistor outputs, RS232 and RS485 ports. Terminal names are the markings of the unit; the I/O table lists the channels. Check the pinout against the datasheet of your unit.</elementInformation>
		<elementInformation name="quantity" show="0">1</elementInformation>
