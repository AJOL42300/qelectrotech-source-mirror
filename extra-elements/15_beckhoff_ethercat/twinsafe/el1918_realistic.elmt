		<elementInformation name="manufacturer_reference" show="1">EL1918</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 8 fail-safe digital inputs, 24 V DC</elementInformation>
		<elementInformation name="description" show="1">TwinSAFE input terminal, 16 terminals: two per safe input, SIn on the terminals n and n+8 (left column 1 to 8, right column 9 to 16). Generic layout, terminal numbering NOT verified against the datasheet: check it before use.</elementInformation>
	</elementInformations>
