	<uuid uuid="{0697949c-c949-59f2-a854-d49da82848e0}" />
	<names>
		<name lang="en">Murrelektronik 7000-40021-6340050 M12 moulded cable 0,5 m</name>
		<name lang="fr">Câble moulé M12 Murrelektronik 7000-40021-6340050 0,5 m</name>
