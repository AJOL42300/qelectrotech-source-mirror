	<names>
		<name lang="en">Pilz 570480 PSEN ml 1.1 actuator for PSENmlock</name>
		<name lang="fr">Actionneur PSEN ml 1.1 Pilz 570480 pour PSENmlock</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Pilz</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">570480</elementInformation>
		<elementInformation name="designation" show="1">Actionneur codé PSEN ml 1.1 pour interrupteur de sécurité à verrouillage PSENmlock</elementInformation>
		<elementInformation name="description" show="1">PSEN ml 1.1 coded actuator for the PSENmlock safety guard locking devices and the PSENmgate systems (the Type 1 actuator of 6M000007 to 6M000009). VERIFIED (Pilz e-shop page of 570480): passive actuator, no electrical connection. ASSUMED: the single terminal MECH is only a marker for the mechanical coupling to the switch, it carries no signal.</elementInformation>
	</elementInformations>
