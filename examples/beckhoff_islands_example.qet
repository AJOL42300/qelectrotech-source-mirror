                <element name="el5152_table.elmt">
                    <definition height="106" hotspot_x="5" hotspot_y="29" link_type="master" type="element" version="0.100.0" width="410">
	<uuid uuid="{f8c15696-642c-5b96-b8df-38e302d662dd}"/>
	<names>
		<name lang="en">EL5152 encoder input terminal - I/O table</name>
		<name lang="fr">EL5152 borne d'entrÃ©e codeur - tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL5152</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 2-channel incremental encoder input</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, encoder input terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 A1, 2 B1, 3 24V1, 4 24V2, 5 A2, 6 B2, 7 0V1, 8 0V2. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="12.00">
			<columnWidths>
				<column index="0" width="60"/>
				<column index="1" width="36"/>
				<column index="2" width="110"/>
				<column index="3" width="90"/>
				<column index="4" width="64"/>
				<column index="5" width="40"/>
			</columnWidths>
			<columnVisibility>
				<column index="5" visible="true"/>
			</columnVisibility>
			<headerFont bold="true" family="Roboto Condensed" size="7"/>
			<cellFont bold="false" family="Roboto Condensed" size="7"/>
			<plcIOs>
				<plcIO address="A1" comment="" crossRef="" functionText="Encoder 1, A" terminalCount="1" type="entree_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="B1" comment="" crossRef="" functionText="Encoder 1, B" terminalCount="1" type="entree_digitale">
					<terminal>2</terminal>
				</plcIO>
				<plcIO address="A2" comment="" crossRef="" functionText="Encoder 2, A" terminalCount="1" type="entree_digitale">
					<terminal>5</terminal>
				</plcIO>
				<plcIO address="B2" comment="" crossRef="" functionText="Encoder 2, B" terminalCount="1" type="entree_digitale">
					<terminal>6</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
	</kindInformations>
