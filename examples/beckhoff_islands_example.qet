	<names>
		<name lang="en">EK1100 EtherCAT Coupler, 2 x RJ45</name>
		<name lang="fr">EK1100 EtherCAT Coupler, 2 x RJ45</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EK1100</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Coupler, 2 x RJ45</elementInformation>
		<elementInformation name="description" show="1">EtherCAT coupler: the upper RJ45 socket goes to the network, the lower one to further EtherCAT devices. The terminals are the two bus sockets; the supply contacts are not drawn (generic layout). The label is the island id.</elementInformation>
	</elementInformations>
	<informations>Author: QElectroTech contributors
