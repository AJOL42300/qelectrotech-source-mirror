	<names>
		<name lang="en">EK1322 EtherCAT P junction - terminal table</name>
		<name lang="fr">EK1322 jonction EtherCAT P - tableau des bornes</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EK1322</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT P junction, 2 ports, with feed-in</elementInformation>
		<elementInformation name="description" show="1">EtherCAT P coupler with feed-in: two P-coded M8 sockets, X1 (previous strand) and X2 (next strand), and four feed-in terminals: 1 Us +24 V DC (system and sensor supply), 2 Us 0 V, 3 Up +24 V DC (peripheral voltage), 4 Up 0 V. Each socket is one terminal. The position of the terminals and of the LEDs (Run, L/A X1, L/A X2, Us, Up) is assumed.</elementInformation>
	</elementInformations>
