	<uuid uuid="{f8c15696-642c-5b96-b8df-38e302d662dd}" />
	<names>
		<name lang="en">EL5152 encoder input terminal - I/O table</name>
		<name lang="fr">EL5152 borne d'entrée codeur - tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL5152</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 2-channel incremental encoder input</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, encoder input terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 A1, 2 B1, 3 24V1, 4 24V2, 5 A2, 6 B2, 7 0V1, 8 0V2. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="12.00">
			<columnWidths>
				<column index="0" width="60" />
				<column index="1" width="66" />
				<column index="2" width="130" />
				<column index="3" width="90" />
				<column index="4" width="64" />
				<column index="5" width="44" />
			</columnWidths>
			<columnVisibility>
				<column index="0" visible="false" />
				<column index="1" visible="true" />
				<column index="2" visible="true" />
				<column index="3" visible="false" />
				<column index="4" visible="false" />
				<column index="5" visible="true" />
			</columnVisibility>
			<columnNames>
				<column index="0" />
				<column index="1">ID TwinCAT</column>
				<column index="2">Label</column>
				<column index="3" />
				<column index="4" />
				<column index="5">N° pin</column>
			</columnNames>
			<columnOrder>5,2,1</columnOrder>
			<headerFont family="Roboto Condensed" size="7" bold="true" />
			<cellFont family="Roboto Condensed" size="7" bold="false" />
			<plcIOs>
				<plcIO type="entree_digitale" address="A1" functionText="Encoder 1, A" comment="" crossRef="" terminalCount="1">
					<terminal>1</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="B1" functionText="Encoder 1, B" comment="" crossRef="" terminalCount="1">
					<terminal>2</terminal>
				</plcIO>
