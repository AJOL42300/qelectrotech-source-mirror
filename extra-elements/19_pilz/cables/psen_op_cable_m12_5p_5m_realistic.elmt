<definition version="0.100.0" type="element" link_type="master" width="120" height="100" hotspot_x="10" hotspot_y="60">
	<uuid uuid="{85c095af-7681-5d38-b439-4cee623aa23e}"/>
	<names>
		<name lang="en">Pilz 630311 connection cable PSEN op cable axial M12 5-pole, 5 m, realistic view</name>
		<name lang="fr">Câble de raccordement Pilz 630311 PSEN op cable axial M12 5-pole, 5 m, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Pilz</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">630311</elementInformation>
		<elementInformation name="designation" show="1">Câble de raccordement PSEN op axial M12 5 pôles, 5 m</elementInformation>
		<elementInformation name="description" show="1">PSEN op cable axial M12 5-pole, 5 m: PUR, yellow (similar to RAL 1003), 5-pin M12 female connector straight (A-coded) on an open cable end, 5 x 0.25 mm2 (AWG 24), unshielded, 5.1 mm. VERIFIED (Pilz data sheet 1002482 of the PSEN op cable M12 5-pin and the data sheet of 630311): the wire colours are brown, white, blue, black, grey. ASSUMED: the colour of each pin, pin 1 BN, pin 2 WH, pin 3 BU, pin 4 BK, pin 5 GY, is the order of the A-coded M12 standard (EN 61076-2-101), the same as the PSEN cs1.1n operating manual; it is not printed in the data sheet. The terminals 1 to 5 are the connector pins, BN WH BU BK GY the wire ends.</elementInformation>
	</elementInformations>
