	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">9000-41042-0100600</elementInformation>
		<elementInformation name="designation" show="1">2-channel electronic circuit breaker, 24 V DC, 2 x 1-2-4-6 A</elementInformation>
		<elementInformation name="description" show="1">one push button with integrated status LED and one current selector per channel; group alarm contact on terminals 13-14 (potential-free); no separate 0 V output terminal per channel (assumed)</elementInformation>
	</elementInformations>
