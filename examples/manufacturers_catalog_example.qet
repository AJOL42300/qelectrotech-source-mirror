                                    <definition height="50" hotspot_x="50" hotspot_y="10" link_type="simple" type="element" version="0.100.0" width="100">
	<uuid uuid="{699389f3-52b1-5bfd-8226-5ae5b30a62c7}"/>
	<names>
		<name lang="en">TeSys D contactor LC1D38P7 38 A 230 V AC</name>
		<name lang="fr">Contacteur TeSys D LC1D38P7 38 A 230 V CA</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">LC1D38P7</elementInformation>
		<elementInformation name="designation" show="1">TeSys D contactor, 3P, 38 A AC-3, 230 V AC coil, 1 NO + 1 NC</elementInformation>
		<elementInformation name="description" show="1">TeSys D contactor LC1D38P7, 3 poles, 38 A AC-3 (18.5 kW at 400 V), coil 230 V AC 50/60 Hz, 1 NO + 1 NC auxiliary contact built in, screw clamp terminals, 45 mm wide. Terminals 1/L1-2/T1, 3/L2-4/T2, 5/L3-6/T3, coil A1-A2, auxiliary 13-14 (NO) and 21-22 (NC).</elementInformation>
		<elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">Front-mounting instantaneous auxiliary contact block LADN22 for TeSys D (LC1D) and TeSys F contactors, 2 NO + 2 NC, screw clamp terminals. Terminal marking 53-54, 61-62, 71-72, 83-84.</elementInformation>
