                                <element name="el1xxx_generic_table.elmt">
                                    <definition height="154" hotspot_x="5" hotspot_y="29" link_type="master" type="element" version="0.100.0" width="250">
	<uuid uuid="{99aab011-80ef-52e2-955c-2984401c9562}"/>
	<names>
		<name lang="en">EL1xxx digital input terminal (generic), I/O table</name>
		<name lang="fr">EL1xxx borne d'entrée numérique (générique), tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="designation" show="1">EL1xxx</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital input terminal. Generic layout: contacts 1 to 8; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 8 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
