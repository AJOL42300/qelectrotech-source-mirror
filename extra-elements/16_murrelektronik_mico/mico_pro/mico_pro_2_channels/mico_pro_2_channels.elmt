	<names>
		<name lang="en">Murrelektronik MICO Pro 2 channels MICO electronic circuit breaker 2 x 1-10 A</name>
		<name lang="fr">Disjoncteur électronique MICO Murrelektronik MICO Pro 2 channels 2 x 1-10 A</name>
