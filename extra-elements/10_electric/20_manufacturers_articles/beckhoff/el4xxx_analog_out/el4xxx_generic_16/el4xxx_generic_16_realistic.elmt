	<names>
		<name lang="en">EL4xxx analog output terminal (generic, 16 terminals), realistic view</name>
		<name lang="fr">EL4xxx borne de sortie analogique (générique, 16 bornes), vue réaliste</name>
	</names>
	<elementInformations>
