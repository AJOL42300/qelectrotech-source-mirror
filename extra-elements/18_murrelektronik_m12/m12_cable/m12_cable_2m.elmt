<definition version="0.100.0" type="element" link_type="simple" width="240" height="100" hotspot_x="20" hotspot_y="50">
	<uuid uuid="{756f4aed-9dc6-5652-93ec-0955b5e789d4}"/>
	<names>
		<name lang="en">Murrelektronik 7000-40021-6340200 M12 moulded cable 2 m</name>
		<name lang="fr">Câble moulé M12 Murrelektronik 7000-40021-6340200 2 m</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">7000-40021-6340200</elementInformation>
		<elementInformation name="designation" show="1">Câble moulé M12 mâle 0° / M12 femelle 0° codé A, PUR 4x0,34, 2 m</elementInformation>
		<elementInformation name="description" show="1">M12 male 0 deg / M12 female 0 deg, A-coded, PUR 4 x 0.34 mm2, 2 m. The female connector has 5 contacts (the contact 5 is present but not wired) and the cable has 4 conductors: 1 brown, 2 white, 3 blue, 4 black on the pins 1 to 4 of both ends (the free contact 5 is the information of the user, not read in the datasheet). Function routing: X1 and X2 are the same channels (1 = pin 4, 2 = pin 2).</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="function_routes">X1:1&gt;X2:1;X1:2&gt;X2:2</kindInformation>
	</kindInformations>
	<informations>Author: QElectroTech contributors
Original vector drawing, not copied from a manufacturer drawing. Ratings and terminal names from the public datasheet; layout and symbols are generic, check them against the datasheet.
License: see http://qelectrotech.org/wiki/doc/elements_license</informations>
