	<names>
		<name lang="en">EL4xxx analog output terminal (generic), realistic view</name>
		<name lang="fr">EL4xxx borne de sortie analogique (générique), vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="designation" show="1">EL4xxx</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, analog output terminal. Generic layout: contacts 1 to 8; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 8 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
