<definition version="0.100.0" type="element" link_type="simple" width="40" height="50" hotspot_x="20" hotspot_y="10">
	<uuid uuid="{4a36dd55-3f5e-5549-839e-c18f0c2f8be8}" />
	<names>
		<name lang="en">ComPacT NSX100B 3P 100 A TMD</name>
		<name lang="fr">ComPacT NSX100B 3P 100 A TMD</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">LV429540</elementInformation>
		<elementInformation name="designation" show="1">ComPacT NSX100B circuit breaker, 3P, 100 A, TMD, 25 kA</elementInformation>
		<elementInformation name="description" show="1">Circuit breaker ComPacT NSX100B, 3P fixed, 25 kA at 415 V, thermal-magnetic trip unit TMD 100 A. 105 x 161 x 86 mm, pole pitch 35 mm.</elementInformation>
		<elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation>
		<elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary1" show="0">29450</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">0</elementInformation>
		<elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation>
		<elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary2" show="0">LV429410</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">0</elementInformation>
		<elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">Direct rotary handle for ComPacT NSX100/160/250, black handle, padlockable in the OFF position, degree of protection IP40 (IK07). Mechanical accessory, no terminal.</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">Direct rotary handle, ComPacT NSX100/160/250, black</elementInformation>
		<elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429337</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">0</elementInformation>
		<elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation>
		<elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation>
		<elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation>
		<elementInformation name="quantity_auxiliary4" show="0">0</elementInformation>
	</elementInformations>
