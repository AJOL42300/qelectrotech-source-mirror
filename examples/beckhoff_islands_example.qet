	<uuid uuid="{590f54c1-1b74-52fc-bda1-74ffb3b54979}"/>
	<names>
		<name lang="en">AX5103 servo drive, 1 axis</name>
		<name lang="fr">AX5103 variateur, 1 axe(s)</name>
