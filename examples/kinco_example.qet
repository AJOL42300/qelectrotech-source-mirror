	<uuid uuid="{5be03ebf-3aa2-56b0-b6de-2e4f95ddaf4d}" />
	<names>
		<name lang="en">KS105C2-16DT Compact PLC, 8 DI, 8 DO, RS232, RS485, 2 x CAN, realistic view</name>
		<name lang="fr">KS105C2-16DT Automate compact, 8 E TOR, 8 S TOR, RS232, RS485, 2 x CAN, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Kinco</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">KS105C2-16DT</elementInformation>
		<elementInformation name="designation" show="1">Compact PLC, 8 DI, 8 DO, RS232, RS485, 2 x CAN</elementInformation>
		<elementInformation name="description" show="1">Kinco KS105 compact PLC, 8 digital inputs and 8 transistor outputs, RS232 and RS485 ports and two CAN ports. Terminal names are the markings of the unit; the I/O table lists the channels. Check the pinout against the datasheet of your unit.</elementInformation>
		<elementInformation name="quantity" show="0">1</elementInformation>
		<elementInformation name="unity" show="0">pcs</elementInformation>
		<elementInformation name="width" show="0">25.4</elementInformation>
		<elementInformation name="height" show="0">100</elementInformation>
