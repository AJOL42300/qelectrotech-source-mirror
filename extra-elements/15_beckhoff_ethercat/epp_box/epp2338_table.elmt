	<names>
		<name lang="en">EPP2338 EtherCAT P box, 8 channels - I/O table</name>
		<name lang="fr">EPP2338 boîtier EtherCAT P, 8 voies - tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EPP2338-0001</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT P Box, 8-channel digital combi, 24 V DC, 10 us, 0.5 A, M8</elementInformation>
		<elementInformation name="description" show="1">EtherCAT P box with four M8 sockets X01 to X04, two channels each, EtherCAT P IN X50 and OUT X51. Generic layout, not the manufacturer drawing: put the picture under it. Fill in the function of each channel in the I/O table; the label of the box is the card id (A1.10).</elementInformation>
	</elementInformations>
