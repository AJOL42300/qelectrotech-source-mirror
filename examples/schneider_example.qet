entInformation name="designation" show="1">iSW switch-disconnector, 3P, 40 A, 415 V</elementInformation><elementInformation name="description" show="1">Switch-disconnector iSW, 3P, 40 A at 415 V AC (AC-22A), EN/IEC 60947-3, 6 x 9 mm (54 mm) wide, 85 mm high, 73 mm deep. Can be fitted with an OF auxiliary contact.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Acti9 iOF open/close auxiliary contact (also fault indication), 1 changeover (1 NO + 1 NC), 6 A at 240 V AC, 9 mm wide, for iC60, iID, iDPN Vigi and iSW 40-125 (public compatibility list). Terminals C, NC, NO ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">iOF auxiliary contact, Acti9, 1 changeover, AC/DC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">A9A26924</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{31841e36-eb1d-56e3-9daa-3d02166c28e4}"><text>-S1</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/acti9_isolators/sti_2p_25a/sti_2p_25a.elmt" uuid="{af017752-9b4c-54e7-9814-da9abd8fa699}" x="270" y="400" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="n" x="30" y="0" /><terminal id="3" orientation="s" x="30" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-S2</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">A9N15651</elementInformation><elementInformation name="designation" show="1">STI fuse-disconnector, 2P, 25 A, for 10.3 x 38 fuses</elementInformation><elementInformation name="description" show="1">Fuse-disconnector STI, 2P, 25 A, for 10.3 x 38 mm fuses, 4 x 9 mm (36 mm) wide, 81 mm high, 75 mm deep.</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{99d8305f-7b3f-5c81-8842-3d5bb775ef8c}"><text>-S2</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_nsx/nsx100b_3p_tmd100/nsx100b_3p_tmd100.elmt" uuid="{855eb517-3169-5ebe-8b5a-a94f5bb6798d}" x="410" y="400" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="n" x="30" y="0" /><terminal id="3" orientation="s" x="30" y="60" /><terminal id="4" orientation="n" x="60" y="0" /><terminal id="5" orientation="s" x="60" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-Q5</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">LV429540</elementInformation><elementInformation name="designation" show="1">ComPacT NSX100B circuit breaker, 3P, 100 A, TMD, 25 kA</elementInformation><elementInformation name="description" show="1">Circuit breaker ComPacT NSX100B, 3P fixed, 25 kA at 415 V, thermal-magnetic trip unit TMD 100 A. 105 x 161 x 86 mm, pole pitch 35 mm.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation><elementInformation name="designation_auxiliary1" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">29450</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation><elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary2" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary2" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">LV429410</elementInformation><elementInformation name="quantity_auxiliary2" show="0">0</elementInformation><elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary3" show="0">Direct rotary handle for ComPacT NSX100/160/250, black handle, padlockable in the OFF position, degree of protection IP40 (IK07). Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary3" show="0">Direct rotary handle, ComPacT NSX100/160/250, black</elementInformation><elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429337</elementInformation><elementInformation name="quantity_auxiliary3" show="0">0</elementInformation><elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation><elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation><elementInformation name="quantity_auxiliary4" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{fdf92e28-b393-5afa-b064-908b1130cdc6}"><text>-Q5</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_nsx/nsx250n_3p_frame/nsx250n_3p_frame.elmt" uuid="{53fa7c95-2fb1-5684-9bed-59c292fe70a1}" x="580" y="400" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="n" x="30" y="0" /><terminal id="3" orientation="s" x="30" y="60" /><terminal id="4" orientation="n" x="60" y="0" /><terminal id="5" orientation="s" x="60" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-Q6</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">C25N3</elementInformation><elementInformation name="designation" show="1">ComPacT NSX250N basic frame, 3P, 250 A, 50 kA, without trip unit</elementInformation><elementInformation name="description" show="1">Basic frame ComPacT NSX250N, 3P, 250 A, 50 kA at 415 V, without trip unit. 105 x 161 x 86 mm.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Standard motor mechanism module MT250 for ComPacT NSX250, control voltage 220-240 V AC 50/60 Hz (208-277 V AC 60 Hz), consumption below 500 VA, automatic spring charging, padlocking still possible, supplied with an SDE adapter. Motor terminals M1-M2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">Motor mechanism module MT250, ComPacT NSX250, 220/240 V AC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">LV431541</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation><elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary2" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation><elementInformation name="designation_auxiliary2" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">29450</elementInformation><elementInformation name="quantity_auxiliary2" show="0">0</elementInformation><elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary3" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary3" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429410</elementInformation><elementInformation name="quantity_auxiliary3" show="0">0</elementInformation><elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation><elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation><elementInformation name="quantity_auxiliary4" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="Align