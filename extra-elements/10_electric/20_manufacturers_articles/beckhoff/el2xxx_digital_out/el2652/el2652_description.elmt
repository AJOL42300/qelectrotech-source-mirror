		<elementInformation name="designation" show="1">EL2652 EtherCAT Terminal, relay output</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, relay output terminal. Generic layout: contacts 1 to 4; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 4 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
