" uuid="{f273275c-9fea-54e5-be32-46cbe6b0ce5f}" x="690" y="150" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-QS1.3</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">LV429410</elementInformation><elementInformation name="designation" show="1">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="description" show="1">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{72e95ea9-9c66-5cf3-9bf9-ac8840e98d34}"><text>-QS1.3</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/acti9_ic60/ic60n_3p/ic60n_3p.elmt" uuid="{a241b3e9-326f-5aff-bcf0-edef714fb426}" x="120" y="400" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="n" x="30" y="0" /><terminal id="3" orientation="s" x="30" y="60" /><terminal id="4" orientation="n" x="60" y="0" /><terminal id="5" orientation="s" x="60" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-QF1</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">A9F74310</elementInformation><elementInformation name="designation" show="1">iC60N miniature circuit breaker, 3P, 10 A, C curve</elementInformation><elementInformation name="description" show="1">Miniature circuit breaker iC60N, 3 poles, 10 A, C curve, thermal-magnetic, 10 kA (IEC/EN 60947-2). Width 6 x 9 mm (54 mm), height 85 mm. One terminal per pole, top and bottom (1-2, 3-4...).</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Acti9 iOF open/close auxiliary contact (also fault indication), 1 changeover (1 NO + 1 NC), 6 A at 240 V AC, 9 mm wide, for iC60, iID, iDPN Vigi and iSW 40-125 (public compatibility list). Terminals C, NC, NO ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">iOF auxiliary contact, Acti9, 1 changeover, AC/DC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">A9A26924</elementInformation><elementInformation name="quantity_auxiliary1" show="0">1</elementInformation><elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary2" show="0">Add-on residual current device Vigi iC60, 3P, 25 A, 30 mA, type AC, instantaneous, 400-415 V AC, for iC60. Width 6 x 9 mm (54 mm), height 91 mm, depth 73.5 mm. Discontinued 23 Sept 2025, not replaced. Mounted next to an iC60: its own terminals are drawn.</elementInformation><elementInformation name="designation_auxiliary2" show="0">Vigi iC60 add-on residual current device, 3P, 25 A, 30 mA, type AC</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">A9V11325</elementInformation><elementInformation name="quantity_auxiliary2" show="0">1</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{6f03441b-abf5-5214-9db4-2caf38712f28}"><text>-QF1</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/accessories/iof_a9a26924/iof_a9a26924.elmt" uuid="{69e5860a-e32a-5087-99c6-02f639690b41}" x="300" y="400" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="s" x="30" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-QF1-OF</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">A9A26924</elementInformation><elementInformation name="designation" show="1">iOF auxiliary contact, Acti9, 1 changeover, AC/DC</elementInformation><elementInformation name="description" show="1">Acti9 iOF open/close auxiliary contact (also fault indication), 1 changeover (1 NO + 1 NC), 6 A at 240 V AC, 9 mm wide, for iC60, iID, iDPN Vigi and iSW 40-125 (public compatibility list). Terminals C, NC, NO ASSUMED.</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{00565431-2e77-5601-b32f-6116b802337f}"><text>-QF1-OF</text><info_name>label</info_name></dyn