06</elementInformation><elementInformation name="designation" show="1">ComPacT INS250 switch-disconnector, 3P, 250 A, black rotary handle</elementInformation><elementInformation name="description" show="1">Non-automatic switch-disconnector ComPacT INS250, 3 poles, 250 A at 415 V AC (AC-22A, AC-23A), 690 V AC / 250 V DC, standard version with black rotary handle, isolation with positive contact indication. Outside dimensions ASSUMED equal to the NSX250 (105 x 161 x 86 mm).</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-55" y="493" rotation_point_center="false" uuid="{a6344d0a-8598-5786-b9fe-d1c1c67597f4}"><text>-S3</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_ins/ins250_4p/ins250_4p_realistic.elmt" uuid="{f7c4a219-9d94-5a8d-bbf2-f6d070254c32}" x="560" y="120" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="430" /><terminal id="2" orientation="n" x="120" y="0" /><terminal id="3" orientation="s" x="120" y="430" /><terminal id="4" orientation="n" x="240" y="0" /><terminal id="5" orientation="s" x="240" y="430" /><terminal id="6" orientation="n" x="360" y="0" /><terminal id="7" orientation="s" x="360" y="430" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-S4</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">31107</elementInformation><elementInformation name="designation" show="1">ComPacT INS250 switch-disconnector, 4P, 250 A, black rotary handle</elementInformation><elementInformation name="description" show="1">Non-automatic switch-disconnector ComPacT INS250, 4 poles, 250 A at 415 V AC (AC-22A, AC-23A), 690 V AC / 250 V DC, standard version with black rotary handle, isolation with positive contact indication. Outside dimensions ASSUMED equal to the NSX250 (140 x 161 x 86 mm).</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-55" y="493" rotation_point_center="false" uuid="{cca2cbbc-7f28-5aa2-be53-cac3ea6a4aab}"><text>-S4</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element></elements><conductors /><inputs /></diagram><diagram author="" auto_page_num="" cols="20" colsize="61" date="null" displayAt="bottom" displaycols="true" displayrows="true" filename="" folio="%id/%total" freezeNewConductor="false" freezeNewElement="false" height="820" indexrev="" locmach="" order="5" plant="" rows="10" rowsize="80" title="Accessories linked by label prefix" titleblocktemplate="A3 landscape" titleblocktemplateCollection="embedded" uuid="{92b16dc0-b67d-591d-b194-df559d2b638b}" version="0.200.1-dev"><defaultconductor bicolor="false" bus="" cable="" color2="#000000" condsize="1" conductor_color="" conductor_section="" dash-size="1" displaytext="1" formula="" function="" horizontal-alignment="AlignBottom" horizrotatetext="0" num="_" numsize="7" onetextperfolio="0" tension_protocol="" text_color="#000000" type="multi" vertical-alignment="AlignRight" vertirotatetext="270" /><elements><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_nsx/nsx250n_3p_tm250/nsx250n_3p_tm250.elmt" uuid="{3ea9c522-dec9-52a8-9a1d-a95147f96ccc}" x="120" y="150" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="n" x="30" y="0" /><terminal id="3" orientation="s" x="30" y="60" /><terminal id="4" orientation="n" x="60" y="0" /><terminal id="5" orientation="s" x="60" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-QS1</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">C25N3TM250C</elementInformation><elementInformation name="designation" show="1">ComPacT NSX250N circuit breaker, 3P, 250 A, thermal-magnetic TM250</elementInformation><elementInformation name="description" show="1">Circuit breaker ComPacT NSX250N, 3P, 250 A, 50 kA at 415 V, thermal-magnetic trip unit TM250. 105 x 161 x 86 mm. The _accessories appearance shows it with the motor mechanism MT250 LV431541 (220/240 V AC), the auxiliary contact 29450 (OF/SD/SDE), the undervoltage release MN LV429410 (24 V DC) and the long terminal shields LV429517.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Standard motor mechanism module MT250 for ComPacT NSX250, control voltage 220-240 V AC 50/60 Hz (208-277 V AC 60 Hz), consumption below 500 VA, automatic spring charging, padlocking still possible, supplied with an SDE adapter. Motor terminals M1-M2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">Motor mechanism module MT250, ComPacT NSX250, 220/240 V AC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">LV431541</elementInformation><elementInformation name="quantity_auxiliary1" show="0">1</elementInformation><elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary2" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation><elementInformation name="designation_auxiliary2" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">29450</elementInformation><elementInformation name="quantity_auxiliary2" show="0">1</elementInformation><elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary3" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary3" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429410</elementInformation><elementInformation name="quantity_auxiliary3" show="0">1</elementInformation><elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation><elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation><elementInformation name="quantity_auxiliary4" show="0">1</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{a2cdd7bc-2640-5d63-9f69-97486b72965d}"><text>-QS1</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/accessories/mt250_220_240vac/mt250_220_240vac.elmt" uuid="{5e3ec9ad-9299-5dea-b0e7-e362242d4dce}" x="420" y="150" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-QS1.1</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">LV431541</elementInformation><elementInformation name="designation" show="1">Motor mechanism module MT250, ComPacT NSX250, 220/240 V AC</elementInformation><elementInformation name="description" show="1">Standard motor mechanism module MT250 for ComPacT NSX250, control voltage 220-240 V AC 50/60 Hz (208-277 V AC 60 Hz), consumption below 500 VA, automatic spring charging, padlocking still possible, supplied with an SDE adapter. Motor terminals M1-M2 ASSUMED.</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1