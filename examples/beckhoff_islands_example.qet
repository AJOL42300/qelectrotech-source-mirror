ference_auxiliary2" show="0">ZS4100-3113</elementInformation><elementInformation name="designation_auxiliary2" show="0">Motor connector AF1000</elementInformation><elementInformation name="quantity_auxiliary2" show="0">1</elementInformation><elementInformation name="unity_auxiliary2" show="0">1</elementInformation><elementInformation name="auxiliary3" show="0">I/O plug X03</elementInformation><elementInformation name="description_auxiliary3" show="0">Plug of the X03 terminal strip (IN1..IN6, GND, TH, OUT, FGND, 24V). Reference NOT identified on the public Beckhoff pages: to be completed from the AF1000 documentation.</elementInformation><elementInformation name="designation_auxiliary3" show="0">X03 connector</elementInformation><elementInformation name="quantity_auxiliary3" show="0">1</elementInformation><elementInformation name="unity_auxiliary3" show="0">1</elementInformation><elementInformation name="auxiliary4" show="0">Mains plug X01</elementInformation><elementInformation name="description_auxiliary4" show="0">Plug of the X01 terminal strip (L1 L2 L3 PE RB+ RB-). Reference NOT identified on the public Beckhoff pages: to be completed from the AF1000 documentation.</elementInformation><elementInformation name="designation_auxiliary4" show="0">X01 connector</elementInformation><elementInformation name="quantity_auxiliary4" show="0">1</elementInformation><elementInformation name="unity_auxiliary4" show="0">1</elementInformation></elementInformations><plcMasterData rowHeight="8.00">
