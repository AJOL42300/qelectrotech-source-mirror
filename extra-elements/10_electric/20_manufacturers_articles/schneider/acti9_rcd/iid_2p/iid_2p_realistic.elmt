<definition version="0.100.0" type="element" link_type="simple" width="60" height="160" hotspot_x="15" hotspot_y="15">
	<uuid uuid="{e7067adb-4d83-506c-902d-e2c8ff9deb32}" />
	<names>
		<name lang="en">iID RCCB 2P 25 A 30 mA AC, front view</name>
		<name lang="fr">Interrupteur différentiel iID 2P 25 A 30 mA AC, vue de face</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">A9R41225</elementInformation>
		<elementInformation name="designation" show="1">iID residual current circuit breaker, 2P, 25 A, 30 mA, type AC</elementInformation>
		<elementInformation name="description" show="1">RCCB iID, 2P, 25 A, 30 mA, type AC, instantaneous. Neutral on the left (N1-N2). Width 4 x 9 mm (36 mm) ASSUMED from the pole pitch.</elementInformation>
		<elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">Acti9 iOF open/close auxiliary contact (also fault indication), 1 changeover (1 NO + 1 NC), 6 A at 240 V AC, 9 mm wide, for iC60, iID, iDPN Vigi and iSW 40-125 (public compatibility list). Terminals C, NC, NO ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">iOF auxiliary contact, Acti9, 1 changeover, AC/DC</elementInformation>
		<elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary1" show="0">A9A26924</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">0</elementInformation>
		<elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">Acti9 iMN instantaneous undervoltage release, control voltage 220-240 V AC 50/60 Hz, trips between 70 % and 35 % of Un, 2 modules of 9 mm, for iC60, iID, iDPN Vigi and iSW-NA (public product page). Coil terminals D1-D2 ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">iMN undervoltage release, Acti9, 220-240 V AC</elementInformation>
		<elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary2" show="0">A9A26960</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">0</elementInformation>
		<elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">Acti9 iMX+OF shunt trip release with an open/close auxiliary contact (OF), control voltage 220-415 V AC, for iC60, iID, iC40 and iSW-NA (public product page). Coil terminals C1-C2 and OF terminals 11, 12, 14 ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">iMX+OF shunt trip release with auxiliary contact, Acti9, 220-415 V AC</elementInformation>
		<elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary3" show="0">A9A26946</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">0</elementInformation>
	</elementInformations>
	<informations>Author: QElectroTech contributors&#10;Generic layout redrawn from the public data of the product (reference, poles, rating, dimensions), not copied from a manufacturer drawing. License: see http://qelectrotech.org/wiki/doc/elements_license
Made by misc/schneider/gen_schneider.py: scale 3.33 px/mm (1 module of 9 mm = 30 px), grid 10 px. License: see http://qelectrotech.org/wiki/doc/elements_license</informations>
