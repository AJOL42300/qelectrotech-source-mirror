		<elementInformation name="designation" show="1">4-channel electronic circuit breaker, 24 V DC, 2 x 1-4 A, 2 x 4-10 A</elementInformation>
		<elementInformation name="description" show="1">one status LED, one push button and one current selector per channel; group alarm output; no separate 0 V output terminal per channel (assumed); channels 1-2 low range, 3-4 high range (assumed)</elementInformation>
	</elementInformations>
