	<names>
		<name lang="en">EL1904 EtherCAT Terminal, 4 fail-safe digital inputs, 24 V DC, description view</name>
		<name lang="fr">EL1904 EtherCAT Terminal, 4 fail-safe digital inputs, 24 V DC, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL1904</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 4 fail-safe digital inputs, 24 V DC</elementInformation>
		<elementInformation name="description" show="1">TwinSAFE input terminal: SI1 to SI4 on the terminals 1, 5, 3 and 7; the terminals 2, 6, 4 and 8 are 0 V. Terminal numbering follows the user's own drawing and is NOT verified against the datasheet: check it before use.</elementInformation>
	</elementInformations>
