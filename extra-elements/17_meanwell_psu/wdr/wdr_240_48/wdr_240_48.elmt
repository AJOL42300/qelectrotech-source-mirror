	<names>
		<name lang="en">Mean Well WDR-240-48 DIN-rail power supply 48 V 5 A</name>
		<name lang="fr">Alimentation rail DIN Mean Well WDR-240-48 48 V 5 A</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">WDR-240-48</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 48 V DC 5 A, 240 W, 63 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 2 +V and 2 -V output terminals as on the datasheet (parallel screws); DC OK relay contact on terminals 13 and 14 (the datasheet numbers the two relay screws differently; 13/14 is a convention); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
