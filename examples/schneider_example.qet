                                    <definition height="550" hotspot_x="60" hotspot_y="60" link_type="simple" type="element" version="0.100.0" width="360">
	<uuid uuid="{48c51b59-5578-5770-b087-394b76a1d3d1}"/>
	<names>
		<name lang="en">ComPacT NSX250N 3P frame, no trip unit, front view</name>
		<name lang="fr">ComPacT NSX250N 3P châssis sans déclencheur, vue de face</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">C25N3</elementInformation>
		<elementInformation name="designation" show="1">ComPacT NSX250N basic frame, 3P, 250 A, 50 kA, without trip unit</elementInformation>
		<elementInformation name="description" show="1">Basic frame ComPacT NSX250N, 3P, 250 A, 50 kA at 415 V, without trip unit. 105 x 161 x 86 mm.</elementInformation>
		<elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">Standard motor mechanism module MT250 for ComPacT NSX250, control voltage 220-240 V AC 50/60 Hz (208-277 V AC 60 Hz), consumption below 500 VA, automatic spring charging, padlocking still possible, supplied with an SDE adapter. Motor terminals M1-M2 ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">Motor mechanism module MT250, ComPacT NSX250, 220/240 V AC</elementInformation>
		<elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary1" show="0">LV431541</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">0</elementInformation>
		<elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary2" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation>
		<elementInformation name="designation_auxiliary2" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation>
		<elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary2" show="0">29450</elementInformation>
		<elementInformation name="quantity_auxiliary2" show="0">0</elementInformation>
		<elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary3" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation>
		<elementInformation name="designation_auxiliary3" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation>
		<elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429410</elementInformation>
		<elementInformation name="quantity_auxiliary3" show="0">0</elementInformation>
		<elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation>
		<elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation>
		<elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation>
