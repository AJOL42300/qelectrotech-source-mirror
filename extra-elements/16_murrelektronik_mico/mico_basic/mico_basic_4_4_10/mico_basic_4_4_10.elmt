	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">9000-41034-0101000</elementInformation>
		<elementInformation name="designation" show="1">4-channel electronic circuit breaker, 24 V DC, 2 x 1-2-3-4 A, 2 x 4-6-8-10 A</elementInformation>
		<elementInformation name="description" show="1">one push button with integrated status LED and one current selector per channel; group alarm contact on terminals 13-14 (potential-free); no separate 0 V output terminal per channel (assumed); channels 1-2 low range, 3-4 high range (assumed)</elementInformation>
	</elementInformations>
