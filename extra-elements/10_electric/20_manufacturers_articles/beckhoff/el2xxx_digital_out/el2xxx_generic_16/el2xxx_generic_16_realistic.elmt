	<names>
		<name lang="en">EL2xxx digital output terminal (generic, 16 terminals), realistic view</name>
		<name lang="fr">EL2xxx borne de sortie numérique (générique, 16 bornes), vue réaliste</name>
	</names>
	<elementInformations>
