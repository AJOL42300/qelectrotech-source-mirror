		<elementInformation name="depth" show="0">47</elementInformation>
		<elementInformation name="auxiliary1" show="0">Power plug</elementInformation>
		<elementInformation name="description_auxiliary1" show="0">3-way screw terminal plug for FG, 0 V and 24 V</elementInformation>
		<elementInformation name="designation_auxiliary1" show="0">Power plug</elementInformation>
		<elementInformation name="quantity_auxiliary1" show="0">1</elementInformation>
