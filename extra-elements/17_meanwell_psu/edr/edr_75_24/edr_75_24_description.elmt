		<elementInformation name="manufacturer_reference" show="1">EDR-75-24</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 24 V DC 3.2 A, 76.8 W, 32 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 2 +V and 2 -V output terminals as on the datasheet (parallel screws); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
