	<names>
		<name lang="en">EL2522 pulse train output terminal</name>
		<name lang="fr">EL2522 borne de sortie train d'impulsions</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2522</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 2-channel pulse train output</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, pulse train output terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 CH1A, 2 CH1C, 3 CH2A, 4 CH2C, 5 CH1B, 6 CH1D, 7 CH2B, 8 CH2D. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
