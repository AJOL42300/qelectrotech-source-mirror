                                <element name="el3xxx_generic_16.elmt">
                                    <definition height="160" hotspot_x="20" hotspot_y="80" link_type="master" type="element" version="0.100.0" width="40">
	<uuid uuid="{747ff07c-f49f-535a-a7db-5d0020926ae0}"/>
	<names>
		<name lang="en">EL3xxx analog input terminal (generic, 16 terminals)</name>
		<name lang="fr">EL3xxx borne d'entrée analogique (générique, 16 bornes)</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="designation" show="1">EL3xxx</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, analog input terminal. Generic layout: contacts 1 to 16; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 16 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
