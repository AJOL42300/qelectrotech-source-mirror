<titleblocktemplate name="A3 ISO 7200 landscape">
<information>ISO 7200 title block for an A3 folio. The first column is left empty for a logo; the owner, document number, supplementary title, document type, status, language and approver are read from the custom fields of the folio (owner, docnumber, subtitle, doctype, status, language, approver).</information>
<logos/>
<grid cols="100px;r25%;r25%;r25%;r25%;" rows="17;17;17;17;">
<field valign="center" hadjust="true" name="owner" displaylabel="true" align="left" col="1" row="0" colspan="1"><value><translation lang="en">%{owner}</translation></value><label><translation lang="en">Legal owner</translation><translation lang="fr">Propriétaire légal</translation><translation lang="de">Rechtlicher Eigentümer</translation><translation lang="es">Propietario legal</translation><translation lang="it">Proprietario legale</translation></label></field>
<field valign="center" hadjust="true" name="docnumber" displaylabel="true" align="left" col="3" row="0" colspan="1"><value><translation lang="en">%{docnumber}</translation></value><label><translation lang="en">Document number</translation><translation lang="fr">N° de document</translation><translation lang="de">Dokumentnummer</translation><translation lang="es">Número de documento</translation><translation lang="it">Numero del documento</translation></label></field>
<field valign="center" hadjust="true" name="title" displaylabel="true" align="left" col="1" row="1" colspan="1"><value><translation lang="en">%title</translation></value><label><translation lang="en">Title</translation><translation lang="fr">Titre</translation><translation lang="de">Titel</translation><translation lang="es">Título</translation><translation lang="it">Titolo</translation></label></field>
<field valign="center" hadjust="true" name="subtitle" displaylabel="true" align="left" col="3" row="1" colspan="1"><value><translation lang="en">%{subtitle}</translation></value><label><translation lang="en">Supplementary title</translation><translation lang="fr">Titre complémentaire</translation><translation lang="de">Zusatztitel</translation><translation lang="es">Título complementario</translation><translation lang="it">Titolo supplementare</translation></label></field>
<field valign="center" hadjust="true" name="doctype" displaylabel="true" align="left" col="1" row="2"><value><translation lang="en">%{doctype}</translation></value><label><translation lang="en">Document type</translation><translation lang="fr">Type de document</translation><translation lang="de">Dokumentart</translation><translation lang="es">Tipo de documento</translation><translation lang="it">Tipo di documento</translation></label></field>
<field valign="center" hadjust="true" name="status" displaylabel="true" align="left" col="2" row="2"><value><translation lang="en">%{status}</translation></value><label><translation lang="en">Status</translation><translation lang="fr">Statut</translation><translation lang="de">Status</translation><translation lang="es">Estado</translation><translation lang="it">Stato</translation></label></field>
<field valign="center" hadjust="true" name="language" displaylabel="true" align="left" col="3" row="2"><value><translation lang="en">%{language}</translation></value><label><translation lang="en">Language</translation><translation lang="fr">Langue</translation><translation lang="de">Sprache</translation><translation lang="es">Idioma</translation><translation lang="it">Lingua</translation></label></field>
<field valign="center" hadjust="true" name="sheet" displaylabel="true" align="left" col="4" row="2"><value><translation lang="en">%{folio-id} / %{folio-total}</translation></value><label><translation lang="en">Sheet</translation><translation lang="fr">Feuille</translation><translation lang="de">Blatt</translation><translation lang="es">Hoja</translation><translation lang="it">Foglio</translation></label></field>
<field valign="center" hadjust="true" name="author" displaylabel="true" align="left" col="1" row="3"><value><translation lang="en">%author</translation></value><label><translation lang="en">Created by</translation><translation lang="fr">Établi par</translation><translation lang="de">Erstellt von</translation><translation lang="es">Creado por</translation><translation lang="it">Creato da</translation></label></field>
<field valign="center" hadjust="true" name="approver" displaylabel="true" align="left" col="2" row="3"><value><translation lang="en">%{approver}</translation></value><label><translation lang="en">Approved by</translation><translation lang="fr">Approuvé par</translation><translation lang="de">Geprüft von</translation><translation lang="es">Aprobado por</translation><translation lang="it">Approvato da</translation></label></field>
<field valign="center" hadjust="true" name="date" displaylabel="true" align="left" col="3" row="3"><value><translation lang="en">%date</translation></value><label><translation lang="en">Date of issue</translation><translation lang="fr">Date d'émission</translation><translation lang="de">Ausgabedatum</translation><translation lang="es">Fecha de emisión</translation><translation lang="it">Data di emissione</translation></label></field>
<field valign="center" hadjust="true" name="revision" displaylabel="true" align="left" col="4" row="3"><value><translation lang="en">%indexrev</translation></value><label><translation lang="en">Revision</translation><translation lang="fr">Révision</translation><translation lang="de">Revision</translation><translation lang="es">Revisión</translation><translation lang="it">Revisione</translation></label></field>
<field valign="center" hadjust="true" name="logo" displaylabel="false" align="center" col="0" row="0" rowspan="2"><value/><label/></field>
<field valign="center" hadjust="true" name="format" displaylabel="true" align="center" col="0" row="3"><value><translation lang="en">A3</translation></value><label><translation lang="en">Format</translation><translation lang="fr">Format</translation><translation lang="de">Format</translation><translation lang="es">Formato</translation><translation lang="it">Formato</translation></label></field>
</grid>
</titleblocktemplate>
