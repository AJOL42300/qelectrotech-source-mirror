                                <element name="el2008_realistic.elmt">
                                    <definition height="170" hotspot_x="20" hotspot_y="80" link_type="master" type="element" version="0.100.0" width="40">
	<uuid uuid="{2bbde952-3ea3-56d2-8fe9-e4c6ffde8e18}"/>
	<names>
		<name lang="en">EL2008 digital output terminal (generic), realistic view</name>
		<name lang="fr">EL2008 borne de sortie numérique (générique), vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2008</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 8-channel digital output, 24 V DC, 0.5 A</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital output terminal. Generic layout: contacts 1 to 8; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 8 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false"/>
				<column index="1" visible="false"/>
				<column index="2" visible="false"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
			</columnVisibility>
			<plcIOs>
				<plcIO address="O1" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="O2" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>5</terminal>
				</plcIO>
				<plcIO address="O3" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>2</terminal>
				</plcIO>
				<plcIO address="O4" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>6</terminal>
				</plcIO>
				<plcIO address="O5" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>3</terminal>
				</plcIO>
				<plcIO address="O6" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>7</terminal>
				</plcIO>
				<plcIO address="O7" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
