	<uuid uuid="{7b4e6476-31e7-5e57-ba69-d853ff13b16a}"/>
	<names>
		<name lang="en">Murrelektronik MICO Basic 4.10 MICO electronic circuit breaker 4 x 4-6-8-10 A, realistic view</name>
		<name lang="fr">Disjoncteur électronique MICO Murrelektronik MICO Basic 4.10 4 x 4-6-8-10 A, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">9000-41034-0401000</elementInformation>
		<elementInformation name="designation" show="1">4-channel electronic circuit breaker, 24 V DC, 4 x 4-6-8-10 A</elementInformation>
		<elementInformation name="description" show="1">one push button with integrated status LED and one current selector per channel; group alarm contact on terminals 13-14 (potential-free); no separate 0 V output terminal per channel (assumed)</elementInformation>
	</elementInformations>
