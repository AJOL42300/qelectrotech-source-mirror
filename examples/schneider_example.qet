nputs /><elementInformations><elementInformation name="label" show="1">-F4</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">A9V11325</elementInformation><elementInformation name="designation" show="1">Vigi iC60 add-on residual current device, 3P, 25 A, 30 mA, type AC</elementInformation><elementInformation name="description" show="1">Add-on residual current device Vigi iC60, 3P, 25 A, 30 mA, type AC, instantaneous, 400-415 V AC, for iC60. Width 6 x 9 mm (54 mm), height 91 mm, depth 73.5 mm. Discontinued 23 Sept 2025, not replaced. Mounted next to an iC60: its own terminals are drawn.</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-25" y="283" rotation_point_center="false" uuid="{97b09387-a3b3-5547-8072-4856fc08d6e9}"><text>-F4</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/acti9_isolators/isw_3p_40a/isw_3p_40a_realistic.elmt" uuid="{6d212743-a320-5444-bdc9-82dd8767178b}" x="650" y="450" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="240" /><terminal id="2" orientation="n" x="60" y="0" /><terminal id="3" orientation="s" x="60" y="240" /><terminal id="4" orientation="n" x="120" y="0" /><terminal id="5" orientation="s" x="120" y="240" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-S1</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference" show="1">A9S65340</elementInformation><elementInformation name="designation" show="1">iSW switch-disconnector, 3P, 40 A, 415 V</elementInformation><elementInformation name="description" show="1">Switch-disconnector iSW, 3P, 40 A at 415 V AC (AC-22A), EN/IEC 60947-3, 6 x 9 mm (54 mm) wide, 85 mm high, 73 mm deep. Can be fitted with an OF auxiliary contact.</elementInformation><elementInformation name="auxiliary1" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary1" show="0">Acti9 iOF open/close auxiliary contact (also fault indication), 1 changeover (1 NO + 1 NC), 6 A at 240 V AC, 9 mm wide, for iC60, iID, iDPN Vigi and iSW 40-125 (public compatibility list). Terminals C, NC, NO ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">iOF auxiliary contact, Acti9, 1 changeover, AC/DC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">A9A26924</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-25" y="263" rotation_point_center="false" uuid="{e8c4a3f4-da91-5211-b1b8-8c42301ba772}"><text>-S1</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/acti9_isolators/sti_2p_25a/sti_2p_25a_realistic.elmt" uuid="{bc23b847-3422-5300-8ea6-856ca6314559}" x="890" y="450" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="230" /><terminal id="2" orientation="