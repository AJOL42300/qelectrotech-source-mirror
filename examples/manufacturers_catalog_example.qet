	<uuid uuid="{0c034b85-e764-5f62-a3a4-27c30c28ad6b}"/>
	<names>
		<name lang="en">EL2652 relay output terminal (generic), I/O table</name>
		<name lang="fr">EL2652 borne de sortie relais (générique), tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2652</elementInformation>
		<elementInformation name="designation" show="1">EL2652 EtherCAT Terminal, relay output</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, relay output terminal. Generic layout: contacts 1 to 4; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 4 contacts: edit it in the element properties.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="12.00">
			<columnWidths>
				<column index="0" width="60"/>
				<column index="1" width="66"/>
				<column index="2" width="130"/>
				<column index="3" width="90"/>
				<column index="4" width="64"/>
				<column index="5" width="44"/>
			</columnWidths>
			<columnVisibility>
				<column index="0" visible="false"/>
				<column index="1" visible="true"/>
				<column index="2" visible="true"/>
				<column index="3" visible="false"/>
				<column index="4" visible="false"/>
				<column index="5" visible="true"/>
			</columnVisibility>
			<columnNames>
				<column index="0"/>
				<column index="1">ID TwinCAT</column>
				<column index="2">Label</column>
				<column index="3"/>
				<column index="4"/>
				<column index="5">N° pin</column>
			</columnNames>
			<columnOrder>5,2,1</columnOrder>
			<headerFont bold="true" family="Roboto Condensed" size="7"/>
			<cellFont bold="false" family="Roboto Condensed" size="7"/>
			<plcIOs>
				<plcIO address="1" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>1</terminal>
				</plcIO>
				<plcIO address="2" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>2</terminal>
				</plcIO>
				<plcIO address="3" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>3</terminal>
				</plcIO>
				<plcIO address="4" comment="" crossRef="" functionText="" terminalCount="1" type="sortie_digitale">
					<terminal>4</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
	</kindInformations>
	<informations>Author: QElectroTech contributors
Generic card: the realistic view and the table are made by misc/beckhoff/gen_generic.py from a donor card of the same housing; the signal of each contact depends on the exact type. License: see http://qelectrotech.org/wiki/doc/elements_license</informations>
