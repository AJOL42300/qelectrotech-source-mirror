	<names>
		<name lang="en">OF/SD/SDE/SDV auxiliary contact 29450, front view</name>
		<name lang="fr">Contact auxiliaire OF/SD/SDE/SDV 29450, vue de face</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Schneider Electric</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">29450</elementInformation>
		<elementInformation name="designation" show="1">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation>
		<elementInformation name="description" show="1">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation>
	</elementInformations>
