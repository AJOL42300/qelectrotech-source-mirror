	<uuid uuid="{1f33342d-0108-5da6-8ee6-9fe74a0b43ed}"/>
	<names>
		<name lang="en">EL2911 safety terminal - I/O table</name>
		<name lang="fr">EL2911 borne de sécurité - tableau d'E/S</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2911</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, labels as drawn (drawing doubled)</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, safety terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 IN1, 2 OUT, 3 GND_UP, 4 IN3, 5 IN2, 6 24V_UP, 7 24V, 8 IN4, 9 IN1, 10 OUT, 11 GND_UP, 12 IN3, 13 IN2, 14 24V_UP, 15 24V, 16 IN4. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
