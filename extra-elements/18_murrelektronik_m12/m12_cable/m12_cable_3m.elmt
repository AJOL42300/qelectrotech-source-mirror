	<names>
		<name lang="en">Murrelektronik 7000-40021-6340300 M12 moulded cable 3 m</name>
		<name lang="fr">Câble moulé M12 Murrelektronik 7000-40021-6340300 3 m</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">7000-40021-6340300</elementInformation>
		<elementInformation name="designation" show="1">Câble moulé M12 mâle 0° / M12 femelle 0° codé A, PUR 4x0,34, 3 m</elementInformation>
		<elementInformation name="description" show="1">M12 male 0 deg / M12 female 0 deg, A-coded, 4 poles, PUR 4 x 0.34 mm2, 3 m. Pins 1 brown, 2 white, 3 blue, 4 black. Function routing: X1 and X2 are the same channels (1 = pin 4, 2 = pin 2).</elementInformation>
	</elementInformations>
