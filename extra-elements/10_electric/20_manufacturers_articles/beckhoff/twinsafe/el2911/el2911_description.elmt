<definition version="0.100.0" type="element" link_type="master" width="140" height="170" hotspot_x="39" hotspot_y="78">
	<uuid uuid="{a60bcbd8-cbd9-51a3-9732-bdf5fa7ad469}" />
	<names>
		<name lang="en">EL2911 safety terminal, description view</name>
		<name lang="fr">EL2911 borne de sécurité, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2911</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, TwinSAFE potential supply terminal, 4 safe inputs and 1 safe output</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, safety terminal. Pin assignment from the public Beckhoff manual of the EL2911 (v2.2.0, section Connection): 1 S1+, 2 SI1, 3 S3+, 4 SI3, 5 S2+, 6 SI2, 7 S4+, 8 SI4, 9 NC, 10 SO1, 11 0V, 12 24V, 13 NC, 14 SO1, 15 0V, 16 24V; pins 9 and 13 are not used, the safe output 1 is on the pins 10 and 14, the supply UP (0 V and 24 V) on 11, 15 and 12, 16. The channel is the signal in the I/O table, not the pin number.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false" />
				<column index="1" visible="false" />
				<column index="2" visible="false" />
				<column index="3" visible="false" />
				<column index="4" visible="false" />
			</columnVisibility>
			<plcIOs>
				<plcIO type="entree_digitale" address="SI1" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>2</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="SI2" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>6</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="SI3" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>4</terminal>
				</plcIO>
				<plcIO type="entree_digitale" address="SI4" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>8</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="SO1" functionText="" comment="" crossRef="" terminalCount="2">
					<terminal>10</terminal>
					<terminal>14</terminal>
				</plcIO>
			</plcIOs>
		</plcMasterData>
	</kindInformations>
