nsumption below 500 VA, automatic spring charging, padlocking still possible, supplied with an SDE adapter. Motor terminals M1-M2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary1" show="0">Motor mechanism module MT250, ComPacT NSX250, 220/240 V AC</elementInformation><elementInformation name="manufacturer_auxiliary1" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary1" show="0">LV431541</elementInformation><elementInformation name="quantity_auxiliary1" show="0">0</elementInformation><elementInformation name="auxiliary2" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary2" show="0">Standard auxiliary contact for ComPacT NSX, NS, PowerPact and EasyPact CVS: ON/OFF (OF), trip (SD), fault trip (SDE) and earth-fault trip (SDV) indication depending on its slot. One changeover contact (1 NO + 1 NC on a common point), 6 A, spring terminals. Terminals C, NC, NO.</elementInformation><elementInformation name="designation_auxiliary2" show="0">Auxiliary contact OF/SD/SDE/SDV, 1 changeover, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary2" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary2" show="0">29450</elementInformation><elementInformation name="quantity_auxiliary2" show="0">0</elementInformation><elementInformation name="auxiliary3" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary3" show="0">Instantaneous undervoltage release MN for ComPacT NSX, 24 V DC, spring terminals. Coil terminals D1-D2 ASSUMED.</elementInformation><elementInformation name="designation_auxiliary3" show="0">MN undervoltage release, ComPacT NSX, 24 V DC, spring terminals</elementInformation><elementInformation name="manufacturer_auxiliary3" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary3" show="0">LV429410</elementInformation><elementInformation name="quantity_auxiliary3" show="0">0</elementInformation><elementInformation name="auxiliary4" show="0">Compatible accessory</elementInformation><elementInformation name="description_auxiliary4" show="0">Long terminal shield for ComPacT NSX100/160/250, 3P, pole pitch 35 mm, degree of protection IP40. Mechanical accessory, no terminal.</elementInformation><elementInformation name="designation_auxiliary4" show="0">Long terminal shield, ComPacT NSX100/160/250, 3P</elementInformation><elementInformation name="manufacturer_auxiliary4" show="0">Schneider Electric</elementInformation><elementInformation name="manufacturer_reference_auxiliary4" show="0">LV429517</elementInformation><elementInformation name="quantity_auxiliary4" show="0">0</elementInformation></elementInformations><dynamic_texts><dynamic_elmt_text Halignment="AlignLeft" Valignment="AlignTop" font="Liberation Sans,9,-1,5,50,0,0,0,0,0,Regular" frame="false" keep_visual_rotation="true" rotation="0" text_from="ElementInfo" text_width="-1" x="-15" y="73" rotation_point_center="false" uuid="{84df9fc3-6cf0-5805-8613-c631706b24e4}"><text>-Q7</text><info_name>label</info_name></dynamic_elmt_text></dynamic_texts><texts_groups /></element><element freezeLabel="false" is_movable="1" orientation="0" prefix="" type="embed://import/10_electric/20_manufacturers_articles/schneider/compact_ins/ins250_3p/ins250_3p.elmt" uuid="{4d9fb0c1-b4b9-5f38-8357-1e93f7912ac5}" x="920" y="400" z="10"><terminals><terminal id="0" orientation="n" x="0" y="0" /><terminal id="1" orientation="s" x="0" y="60" /><terminal id="2" orientation="n" x="30" y="0" /><terminal id="3" orientation="s" x="30" y="60" /><terminal id="4" orientation="n" x="60" y="0" /><terminal id="5" orientation="s" x="60" y="60" /></terminals><inputs /><elementInformations><elementInformation name="label" show="1">-S3</elementInformation><elementInformation name="manufacturer" show="1">Schneider Electr