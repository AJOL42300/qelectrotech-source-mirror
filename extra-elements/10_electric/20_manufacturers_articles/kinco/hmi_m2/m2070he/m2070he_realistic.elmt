	<names>
		<name lang="en">M2070HE HMI M2, 7 in, 1024 x 600, Ethernet, realistic view</name>
		<name lang="fr">M2070HE IHM M2, 7 pouces, 1024 x 600, Ethernet, vue réaliste</name>
