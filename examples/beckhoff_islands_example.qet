<project title="Beckhoff EtherCAT island example" uuid="{8336788e-2ad3-503b-8950-cd4ab3e353ce}" version="0.200.1"><properties/><titleblocktemplates><titleblocktemplate name="A3 landscape">
<information>Two-row strip for an A3 landscape folio. The first cell is left empty for a logo.</information>
<logos />
<grid cols="100px;r25%;r50%;r25%;" rows="25;25;">
<field valign="center" hadjust="true" name="author" displaylabel="true" align="left" col="1" row="0"><value><translation lang="en">%author</translation></value><label><translation lang="en">Author</translation><translation lang="fr">Auteur</translation><translation lang="de">Autor</translation><translation lang="es">Autor</translation><translation lang="it">Autore</translation></label></field>
