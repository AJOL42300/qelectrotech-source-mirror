	<names>
		<name lang="en">Mean Well SDR-960-24 DIN-rail power supply 24 V 40 A</name>
		<name lang="fr">Alimentation rail DIN Mean Well SDR-960-24 24 V 40 A</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">SDR-960-24</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 24 V DC 40 A, 960 W, 110 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 3 +V and 3 -V output terminals as on the datasheet (parallel screws); DC OK relay contact on terminals 13 and 14 (the datasheet numbers the two relay screws differently; 13/14 is a convention); current share terminals P- and P+ (control connector); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
