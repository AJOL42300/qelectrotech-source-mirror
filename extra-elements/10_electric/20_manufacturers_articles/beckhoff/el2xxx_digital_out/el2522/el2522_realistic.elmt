				</plcIO>
				<plcIO type="sortie_digitale" address="CH1C" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>2</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="CH2A" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>3</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="CH2C" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>4</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="CH1B" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>5</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="CH1D" functionText="" comment="" crossRef="" terminalCount="1">
