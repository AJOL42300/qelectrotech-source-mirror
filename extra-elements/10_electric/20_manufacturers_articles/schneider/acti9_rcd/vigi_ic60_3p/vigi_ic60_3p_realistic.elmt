	<names>
		<name lang="en">Vigi iC60 add-on RCD 3P 25 A 30 mA AC, front view</name>
		<name lang="fr">Bloc différentiel Vigi iC60 3P 25 A 30 mA AC, vue de face</name>
	</names>
	<elementInformations>
