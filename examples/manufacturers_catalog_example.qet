	<names>
		<name lang="en">Mean Well SDR-480-24 DIN-rail power supply 24 V 20 A, realistic view</name>
		<name lang="fr">Alimentation rail DIN Mean Well SDR-480-24 24 V 20 A, vue réaliste</name>
