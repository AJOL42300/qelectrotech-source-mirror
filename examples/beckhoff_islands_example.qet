	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2008</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 8-channel digital output, 24 V DC, 0.5 A</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital output terminal. Generic layout: contacts 1 to 8; the signal on each contact depends on the exact type, see its datasheet. The I/O table lists the 8 contacts: edit it in the element properties.</elementInformation>
