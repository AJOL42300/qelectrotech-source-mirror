	<names>
		<name lang="en">M2070HE HMI M2, 7 in, 1024 x 600, Ethernet, description view</name>
		<name lang="fr">M2070HE IHM M2, 7 pouces, 1024 x 600, Ethernet, vue description</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Kinco</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">M2070HE</elementInformation>
		<elementInformation name="designation" show="1">HMI M2, 7 in, 1024 x 600, Ethernet</elementInformation>
		<elementInformation name="description" show="1">Kinco HMI M2 series M2070HE, 7 inch 1024 x 600 operator panel. Panel cut-out (W x H): 192 x 138 mm, verified, source: https://dl.kinco-automation.com/HMI/manual/M2/Flyer_M2070HE.pdf and https://kincoautomation.ru/en/product/automation/m2/mass-series-2-m2-m2070he-11860. The terminals are the power plug, the COM ports (pin number and signal), Ethernet and the USB ports; the pinout is the one of the MT070 / GL070E manuals and is assumed identical on this model, check it against the datasheet.</elementInformation>
		<elementInformation name="quantity" show="0">1</elementInformation>
