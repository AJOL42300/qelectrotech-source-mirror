	<names>
		<name lang="en">Mean Well WDR-120-12 DIN-rail power supply 12 V 10 A, realistic view</name>
		<name lang="fr">Alimentation rail DIN Mean Well WDR-120-12 12 V 10 A, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Mean Well</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">WDR-120-12</elementInformation>
		<elementInformation name="designation" show="1">DIN-rail power supply, AC input, 12 V DC 10 A, 120 W, 40 mm wide</elementInformation>
		<elementInformation name="description" show="1">DC OK LED and V ADJ output voltage trimmer on the front; 1 +V and 1 -V output terminals as on the datasheet (parallel screws); DC OK relay contact on terminals 13 and 14 (the datasheet numbers the two relay screws differently; 13/14 is a convention); terminal order of the symbol is a convention, the physical order depends on the series</elementInformation>
	</elementInformations>
