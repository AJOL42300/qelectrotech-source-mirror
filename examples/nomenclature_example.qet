    <diagram author="" auto_page_num="" cols="20" colsize="61" date="null" displayAt="bottom" displaycols="true" displayrows="true" filename="" folio="%id/%total" freezeNewConductor="false" freezeNewElement="false" height="820" indexrev="" locmach="" order="5" plant="" rows="10" rowsize="80" title="Flat bill of materials" titleblocktemplate="A3 landscape" titleblocktemplateCollection="embedded" uuid="{e10e04a6-6cee-5517-85dc-f9cf06051e8a}" version="0.200.1-dev">
        <defaultconductor bicolor="false" bus="" cable="" color2="#000000" condsize="1" conductor_color="" conductor_section="" dash-size="1" displaytext="1" formula="" function="" horizontal-alignment="AlignBottom" horizrotatetext="0" num="_" numsize="7" onetextperfolio="0" tension_protocol="" text_color="#000000" type="multi" vertical-alignment="AlignRight" vertirotatetext="270"/>
        <tables>
            <graphics_table display_n_row="0" height="286" name="Flat BOM" uuid="{fecedeca-4714-5087-8377-dd73d2a30cd7}" width="1570" x="10" y="10">
                <graphics_header>
                    <margins>5;5;5;5</margins>
                </graphics_header>
                <model>
                    <project_data_base_model>
                        <identifier>nomenclature</identifier>
                        <query>SELECT ROW_NUMBER() OVER (ORDER BY manufacturer, article, name, refs) AS number, qty AS quantity, name, article AS part_number, refs AS "references", manufacturer, unit FROM (SELECT manufacturer, article, MIN(name) AS name, unit, SUM(qty) AS qty, GROUP_CONCAT(DISTINCT label) AS refs FROM (SELECT TRIM(COALESCE(manufacturer, '')) AS manufacturer, TRIM(COALESCE(manufacturer_reference, '')) AS article, COALESCE(NULLIF(TRIM(description), ''), designation, '') AS name, label, TRIM(COALESCE(unity, '')) AS unit, CAST(REPLACE(COALESCE(NULLIF(TRIM(quantity), ''), '1'), ',', '.') AS REAL) AS qty, 'row:' || CAST(ROW_NUMBER() OVER () AS TEXT) || ':' AS item_key FROM element_nomenclature_view WHERE (TRIM(COALESCE(manufacturer_reference, '')) &lt;> '' OR TRIM(COALESCE(designation, '')) &lt;> '' OR TRIM(COALESCE(description, '')) &lt;> '') AND NOT (TRIM(COALESCE(quantity, '')) &lt;> '' AND TRIM(quantity, ' 0.,') = '') UNION ALL SELECT TRIM(COALESCE(manufacturer_auxiliary1, '')) AS manufacturer, TRIM(COALESCE(manufacturer_reference_auxiliary1, '')) AS article, COALESCE(NULLIF(TRIM(description_auxiliary1), ''), designation_auxiliary1, '') AS name, label, TRIM(COALESCE(unity_auxiliary1, '')) AS unit, CAST(REPLACE(COALESCE(NULLIF(TRIM(quantity_auxiliary1), ''), '1'), ',', '.') AS REAL) AS qty, 'row:' || CAST(ROW_NUMBER() OVER () AS TEXT) || ':_auxiliary1' AS item_key FROM element_nomenclature_view WHERE (TRIM(COALESCE(manufacturer_reference_auxiliary1, '')) &lt;> '' OR TRIM(COALESCE(designation_auxiliary1, '')) &lt;> '' OR TRIM(COALESCE(description_auxiliary1, '')) &lt;> '') AND NOT (TRIM(COALESCE(quantity_auxiliary1, '')) &lt;> '' AND TRIM(quantity_auxiliary1, ' 0.,') = '') UNION ALL SELECT TRIM(COALESCE(manufacturer_auxiliary2, '')) AS manufacturer, TRIM(COALESCE(manufacturer_reference_auxiliary2, '')) AS article, COALESCE(NULLIF(TRIM(description_auxiliary2), ''), designation_auxiliary2, '') AS name, label, TRIM(COALESCE(unity_auxiliary2, '')) AS unit, CAST(REPLACE(COALESCE(NULLIF(TRIM(quantity_auxiliary2), ''), '1'), ',', '.') AS REAL) AS qty, 'row:' || CAST(ROW_NUMBER() OVER () AS TEXT) || ':_auxiliary2' AS item_key FROM element_nomenclature_view WHERE (TRIM(COALESCE(manufacturer_reference_auxiliary2, '')) &lt;> '' OR TRIM(COALESCE(designation_auxiliary2, '')) &lt;> '' OR TRIM(COALESCE(description_auxiliary2, '')) &lt;> '') AND NOT (TRIM(COALESCE(quantity_auxiliary2, '')) &lt;> '' AND TRIM(quantity_auxiliary2, ' 0.,') = '') UNION ALL SELECT TRIM(COALESCE(manufacturer_auxiliary3, '')) AS manufacturer, TRIM(COALESCE(manufacturer_reference_auxiliary3, '')) AS article, COALESCE(NULLIF(TRIM(description_auxiliary3), ''), designation_auxiliary3, '') AS name, label, TRIM(COALESCE(unity_auxiliary3, '')) AS unit, CAST(REPLACE(COALESCE(NULLIF(TRIM(quantity_auxiliary3), ''), '1'), ',', '.') AS REAL) AS qty, 'row:' || CAST(ROW_NUMBER() OVER () AS TEXT) || ':_auxiliary3' AS item_key FROM element_nomenclature_view WHERE (TRIM(COALESCE(manufacturer_reference_auxiliary3, '')) &lt;> '' OR TRIM(COALESCE(designation_auxiliary3, '')) &lt;> '' OR TRIM(COALESCE(description_auxiliary3, '')) &lt;> '') AND NOT (TRIM(COALESCE(quantity_auxiliary3, '')) &lt;> '' AND TRIM(quantity_auxiliary3, ' 0.,') = '') UNION ALL SELECT TRIM(COALESCE(manufacturer_auxiliary4, '')) AS manufacturer, TRIM(COALESCE(manufacturer_reference_auxiliary4, '')) AS article, COALESCE(NULLIF(TRIM(description_auxiliary4), ''), designation_auxiliary4, '') AS name, label, TRIM(COALESCE(unity_auxiliary4, '')) AS unit, CAST(REPLACE(COALESCE(NULLIF(TRIM(quantity_auxiliary4), ''), '1'), ',', '.') AS REAL) AS qty, 'row:' || CAST(ROW_NUMBER() OVER () AS TEXT) || ':_auxiliary4' AS item_key FROM element_nomenclature_view WHERE (TRIM(COALESCE(manufacturer_reference_auxiliary4, '')) &lt;> '' OR TRIM(COALESCE(designation_auxiliary4, '')) &lt;> '' OR TRIM(COALESCE(description_auxiliary4, '')) &lt;> '') AND NOT (TRIM(COALESCE(quantity_auxiliary4, '')) &lt;> '' AND TRIM(quantity_auxiliary4, ' 0.,') = '')) GROUP BY manufacturer, article, unit, CASE WHEN TRIM(article) = '' THEN COALESCE(label, '') || item_key ELSE '' END) ORDER BY manufacturer, article, name, refs</query>
                        <index00 alignment="" font="Liberation Sans,9,-1,5,50,0,0,0,0,0" margins="5;5;5;5"/>
