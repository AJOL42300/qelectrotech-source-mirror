                        <names>
                            <name lang="en">Lanbao PDB-CC50TGI (80-500 mm, 4-20 mA + switch, cable)</name>
                            <name lang="fr">Lanbao PDB-CC50TGI (80-500 mm, 4-20 mA + tout ou rien, câble)</name>
