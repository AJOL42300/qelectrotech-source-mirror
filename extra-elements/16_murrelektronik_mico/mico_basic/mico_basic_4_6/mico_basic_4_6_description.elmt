	<names>
		<name lang="en">Murrelektronik MICO Basic 4.6 MICO electronic circuit breaker 4 x 1-2-4-6 A, description view</name>
		<name lang="fr">Disjoncteur électronique MICO Murrelektronik MICO Basic 4.6 4 x 1-2-4-6 A, vue descriptive</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">9000-41034-0100600</elementInformation>
		<elementInformation name="designation" show="1">4-channel electronic circuit breaker, 24 V DC, 4 x 1-2-4-6 A</elementInformation>
		<elementInformation name="description" show="1">one push button with integrated status LED and one current selector per channel; group alarm contact on terminals 13-14 (potential-free); no separate 0 V output terminal per channel (assumed)</elementInformation>
	</elementInformations>
