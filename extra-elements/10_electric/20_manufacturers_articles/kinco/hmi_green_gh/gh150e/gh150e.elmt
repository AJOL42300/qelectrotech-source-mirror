	<names>
		<name lang="en">GH150E HMI Green Enhanced, 15 in, 1024 x 768, Ethernet</name>
		<name lang="fr">GH150E IHM Green Enhanced, 15 pouces, 1024 x 768, Ethernet</name>
	</names>
	<elementInformations>
