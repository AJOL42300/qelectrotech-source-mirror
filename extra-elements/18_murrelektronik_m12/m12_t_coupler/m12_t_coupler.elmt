	<names>
		<name lang="en">Murrelektronik 7000-41135-0000000 M12 T coupler male / 2 x female A-coded, LED</name>
		<name lang="fr">Coupleur T M12 Murrelektronik 7000-41135-0000000 mâle / 2 x femelle codé A, LED</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Murrelektronik</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">7000-41135-0000000</elementInformation>
		<elementInformation name="designation" show="1">Coupleur T M12 mâle (5 pôles) / 2 x M12 femelle (4 pôles) codé A, LED</elementInformation>
		<elementInformation name="description" show="1">T coupler (Slim Line), M12 male 5 poles A-coded to two M12 female 4 poles A-coded, LEDs, distribution function. Function routing: channel 1 (pin 4) to X2, channel 2 (pin 2) to X3.</elementInformation>
	</elementInformations>
