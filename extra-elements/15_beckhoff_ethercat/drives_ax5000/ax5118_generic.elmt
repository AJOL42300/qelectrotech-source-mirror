	<names>
		<name lang="en">AX5118 servo drive, 1 axis - generic</name>
		<name lang="fr">AX5118 variateur, 1 axe(s) - générique</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">AX5118</elementInformation>
		<elementInformation name="designation" show="1">AX5118 digital compact servo drive, 1 axis</elementInformation>
		<elementInformation name="description" show="1">AX 1-axis drive (the second digit of the reference is the number of axes). Rating from the project nomenclature: 18 A. Redrawn in vector from a picture of the project, terminals snapped to the 10 px grid. The motor and brake connectors are not on the pictures: the Motor terminals are generic, under the body. X06 function names are generic (0..7).</elementInformation>
	</elementInformations>
