<definition version="0.100.0" type="element" link_type="master" width="240" height="290" hotspot_x="20" hotspot_y="70">
	<uuid uuid="{dd89b159-4a0c-5aaa-8ecb-a5b43fcbf093}"/>
	<names>
		<name lang="en">Pilz C1000073 connection cable M23 19-pin cable, 5 m, realistic view</name>
		<name lang="fr">Câble de raccordement Pilz C1000073 M23 19-pin cable, 5 m, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Pilz</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">C1000073</elementInformation>
		<elementInformation name="designation" show="1">Câble de raccordement M23 19 broches, 19 x 0,25 mm2, 5 m</elementInformation>
		<elementInformation name="description" show="1">Connection cable, 19-pin M23 female connector straight, 19 x 0.25 mm2 (AWG 24), unshielded, PUR, yellow (RAL 1003), 8.05 mm, 2 A, 5 m. VERIFIED (Pilz e-shop page and data sheet of the order number): connector, conductors, section and length. ASSUMED: the wire colours, pin 1 RD, pin 2 GY, pin 3 VT, pin 4 YE, pin 5 GN, pin 6 BU, pin 7 WH, pin 8 RDBU, pin 9 GYBN, pin 10 BNGN, pin 11 YEBN, pin 12 GNYE, pin 13 BK, pin 14 WHYE, pin 15 WHGN, pin 16 WHGY, pin 17 GYPK, pin 18 PK, pin 19 BN, are the 'Cable colour (Pilz cable)' column of the PSEN mg1-A-LLFXX operating manual 1006672 (verified there), applied here to this Pilz cable; the end opposite to the connector is taken as open wires (the data sheet lists one connector only). The terminals 1 to 19 are the connector pins, the codes the wire ends.</elementInformation>
	</elementInformations>
