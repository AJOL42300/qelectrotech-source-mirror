	<names>
		<name lang="en">EL2004 digital output terminal, realistic view</name>
		<name lang="fr">EL2004 borne de sortie numérique, vue réaliste</name>
	</names>
	<elementInformations>
		<elementInformation name="manufacturer" show="1">Beckhoff</elementInformation>
		<elementInformation name="manufacturer_reference" show="1">EL2004</elementInformation>
		<elementInformation name="designation" show="1">EtherCAT Terminal, 4-channel digital output, 24 V DC, 0.5 A</elementInformation>
		<elementInformation name="description" show="1">EtherCAT Terminal, digital output terminal. Pin names are the Beckhoff terminal points in the order of the user's own drawing (left column 1 to 4, right column 5 to 8): 1 Q1, 2 0V1, 3 Q3, 4 0V3, 5 Q2, 6 0V2, 7 Q4, 8 0V4. The channel is the signal in the I/O table, not the pin number. Check this against the datasheet of your terminal.</elementInformation>
	</elementInformations>
	<kindInformations>
		<kindInformation name="type">plc</kindInformation>
		<plcMasterData rowHeight="8.00">
			<columnVisibility>
				<column index="0" visible="false" />
				<column index="1" visible="false" />
				<column index="2" visible="false" />
				<column index="3" visible="false" />
				<column index="4" visible="false" />
			</columnVisibility>
			<plcIOs>
				<plcIO type="sortie_digitale" address="Q1" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>1</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="Q3" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>3</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="Q2" functionText="" comment="" crossRef="" terminalCount="1">
					<terminal>5</terminal>
				</plcIO>
				<plcIO type="sortie_digitale" address="Q4" functionText="" comment="" crossRef="" terminalCount="1">
