	<names>
		<name lang="en">GL104E HMI Green Basic, 10.4 in, 800 x 600, Ethernet, realistic view</name>
		<name lang="fr">GL104E IHM Green Basic, 10.4 pouces, 800 x 600, Ethernet, vue réaliste</name>
